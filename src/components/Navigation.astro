<script>
  function toggleMenu() {
    const sidebar = document.getElementById('sidebar');
    if (sidebar) {
      sidebar.classList.toggle('open');
    }
  }

  // Hamburger button event listener
  const hamburgerBtn = document.getElementById('hamburger-btn');
  if (hamburgerBtn) {
    hamburgerBtn.addEventListener('click', toggleMenu);
  }

  // Close button event listener
  const closeBtn = document.getElementById('close-btn');
  if (closeBtn) {
    closeBtn.addEventListener('click', toggleMenu);
  }

  // Dark mode toggle function
  function toggleTheme() {
    const currentTheme = document.documentElement.getAttribute('data-theme');
    const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
    
    // Toggle theme
    document.documentElement.setAttribute('data-theme', newTheme);
    localStorage.setItem('theme', newTheme);
  }

  // Desktop theme toggle
  const themeToggleBtn = document.getElementById('theme-toggle-btn') as HTMLButtonElement;
  if (themeToggleBtn) {
    // Varsayılan tema: light
    const savedTheme = localStorage.getItem('theme') || 'light';
    document.documentElement.setAttribute('data-theme', savedTheme);
    themeToggleBtn.classList.toggle('dark', savedTheme === 'dark');

    themeToggleBtn.addEventListener('click', () => {
      toggleTheme();
      const currentTheme = document.documentElement.getAttribute('data-theme');
      themeToggleBtn.classList.toggle('dark', currentTheme === 'dark');
      themeToggleBtn.setAttribute('aria-label', currentTheme === 'dark' ? 'Açık moda geç' : 'Koyu moda geç');
    });
  }

  // Mobile theme toggle
  const themeToggleBtnMobile = document.getElementById('theme-toggle-btn-mobile') as HTMLButtonElement;
  if (themeToggleBtnMobile) {
    // Varsayılan tema: light
    const savedTheme = localStorage.getItem('theme') || 'light';
    document.documentElement.setAttribute('data-theme', savedTheme);
    themeToggleBtnMobile.classList.toggle('dark', savedTheme === 'dark');

    themeToggleBtnMobile.addEventListener('click', () => {
      toggleTheme();
      const currentTheme = document.documentElement.getAttribute('data-theme');
      themeToggleBtnMobile.classList.toggle('dark', currentTheme === 'dark');
      themeToggleBtnMobile.setAttribute('aria-label', currentTheme === 'dark' ? 'Açık moda geç' : 'Koyu moda geç');
    });
  }

  // Close sidebar when clicking outside
  document.addEventListener('click', (e) => {
    const sidebar = document.getElementById('sidebar');
    const hamburgerBtn = document.getElementById('hamburger-btn');
    if (sidebar && hamburgerBtn && sidebar.classList.contains('open') && !sidebar.contains(e.target as Node) && !hamburgerBtn.contains(e.target as Node)) {
      sidebar.classList.remove('open');
    }
  });

  // Swipe gesture to open/close sidebar
  let touchStartX = 0;
  let touchEndX = 0;
  
  document.addEventListener('touchstart', (e) => {
    touchStartX = e.changedTouches[0].screenX;
  }, { passive: true });
  
  document.addEventListener('touchend', (e) => {
    touchEndX = e.changedTouches[0].screenX;
    handleSwipe();
  }, { passive: true });
  
  function handleSwipe() {
    const sidebar = document.getElementById('sidebar');
    if (!sidebar) return;
    
    const swipeDistance = touchEndX - touchStartX;
    const minSwipeDistance = 50; // Minimum swipe distance in pixels
    
    // Swipe right to open (from left edge)
    if (swipeDistance > minSwipeDistance && touchStartX < 50) {
      sidebar.classList.add('open');
    }
    
    // Swipe left to close (when sidebar is open)
    if (swipeDistance < -minSwipeDistance && sidebar.classList.contains('open')) {
      sidebar.classList.remove('open');
    }
  }

  // Logout functionality
  async function handleLogout() {
    try {
      await fetch('/api/auth/logout', {
        method: 'POST',
      });
    } catch (error) {
      console.error('Logout error:', error);
    } finally {
      // API yaniti ne olursa olsun oturumu kapatma niyetiyle login'e don.
      window.location.href = '/login';
    }
  }

  const logoutBtn = document.getElementById('logout-btn');
  if (logoutBtn) {
    logoutBtn.addEventListener('click', handleLogout);
  }

  const logoutBtnMobile = document.getElementById('logout-btn-mobile');
  if (logoutBtnMobile) {
    logoutBtnMobile.addEventListener('click', handleLogout);
  }
</script>
