<style>
  /* Desktop Navigation */
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: flex-start;
  }

  nav a {
    color: white;
    text-decoration: none;
    padding: 0.5rem 1rem;
    border-radius: 25px;
    transition: background 0.2s;
    background: rgba(255, 255, 255, 0.1);
    font-size: 0.9rem;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  nav a.menu-guzergah {
    padding: 0.45rem 1rem;
    background: rgba(59, 130, 246, 0.2);
    font-weight: 600;
  }

  nav a.menu-guzergah svg {
    width: 18px;
    height: 18px;
  }

  nav a.menu-guzergah:hover {
    background: rgba(59, 130, 246, 0.35);
  }

  /* Tren Saatleri menu style (match Güzergah) */
  nav a.menu-tren-saatleri {
    padding: 0.45rem 1rem;
    background: rgba(59, 130, 246, 0.18);
    font-weight: 600;
  }

  nav a.menu-tren-saatleri svg {
    width: 16px;
    height: 16px;
  }

  nav a.menu-tren-saatleri:hover {
    background: rgba(59, 130, 246, 0.35);
  }

  nav a:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  nav a svg {
    flex-shrink: 0;
  }

  /* Dropdown Styles */
  .dropdown {
    position: relative;
    display: inline-block;
  }

  .dropdown-btn {
    color: white;
    text-decoration: none;
    padding: 0.5rem 1rem;
    border-radius: 25px;
    transition: background 0.2s;
    background: rgba(59, 130, 246, 0.3);
    font-size: 0.9rem;
    white-space: nowrap;
    border: 1px solid rgba(59, 130, 246, 0.5);
    cursor: pointer;
    display: flex;
