// Kurumsal sistem linkleri
const sayfaLinkleri = [
  {
    id: 'guzergah',
    title: 'Haritalar',
    description: 'Marmaray ve İstanbul ulaşım haritaları',
    icon: '🛤️',
    color: '#2563eb',
    href: '/guzergah',
    external: false
  },
  {
    id: 'dahili-numaralar',
    title: 'Dahili Numaralar',
    description: 'Dahili telefon numarası listesi',
    icon: '📞',
    color: '#0ea5e9',
    href: '/dahili-numaralar',
    external: false
  },
  {
    id: 'vardiya',
    title: 'Vardiya',
    description: 'Vardiya plan ve takvim ekranı',
    icon: '📅',
    color: '#7c3aed',
    href: '/vardiya',
    external: false
  },
  {
    id: 'istasyon-semasi',
    title: 'İstasyon Şeması',
    description: 'İstasyon şema ve plan görünümü',
    icon: '🗺️',
    color: '#0d9488',
    href: '/istasyon-semasi',
    external: false
  },
  {
    id: 'kayip-esya',
    title: 'Kayıp Eşya',
    description: 'Kayıp eşya kayıt ve takip ekranı',
