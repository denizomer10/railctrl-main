    icon: '🏥',
    color: '#10b981',
    pdf: '/files/Periyodik Muayene.pdf'
  },
  {
    id: 'lojman-basvuru',
    title: 'Lojman Başvuru Formu',
    description: 'Lojman tahsis başvuru formu',
    icon: '🏠',
    color: '#f59e0b',
    pdf: '/files/lojman-basvuru.pdf'
  },
  {
