---
import PageLayout from '../layouts/PageLayout.astro';

// Check if user is admin
const user = Astro.locals.user;
if (!user || user.role !== 'admin') {
  return Astro.redirect('/403');
}
---

<PageLayout title="Kullanıcı Yönetimi">
  <h2>Kullanıcı Yönetimi</h2>

  <div class="admin-container">
    <!-- Add User Form -->
    <div class="card">
      <h3>Yeni Kullanıcı Ekle</h3>
      <form id="addUserForm" class="user-form">
        <div class="form-row">
          <div class="form-group">
            <label for="email">E-posta</label>
            <input type="email" id="email" name="email" required />
          </div>
          <div class="form-group">
            <label for="name">Ad Soyad</label>
            <input type="text" id="name" name="name" required />
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="password">Şifre</label>
            <input type="password" id="password" name="password" required minlength="8" />
          </div>
          <div class="form-group">
            <label for="role">Rol</label>
            <select id="role" name="role" required>
              <option value="user">Personel</option>
              <option value="sef">Şef</option>
              <option value="gar_mudur">Gar Müdürü</option>
              <option value="admin">Admin</option>
            </select>
          </div>
        </div>
        <button type="submit" class="submit-btn">Kullanıcı Ekle</button>
      </form>
      <div id="addUserMessage" class="message" style="display: none;"></div>
    </div>

    <!-- User List -->
    <div class="card">
      <h3>Mevcut Kullanıcılar</h3>
      <div id="loadingUsers" class="loading">
        <div class="loading-spinner"></div>
        <p>Yükleniyor...</p>
      </div>
      <div id="userList" class="user-list" style="display: none;">
        <table class="users-table">
          <thead>
            <tr>
              <th>E-posta</th>
              <th>Ad Soyad</th>
              <th>Rol</th>
              <th>Durum</th>
              <th>Oluşturulma</th>
              <th>İşlemler</th>
            </tr>
          </thead>
          <tbody id="usersTableBody"></tbody>
        </table>
      </div>
      <div id="noUsers" class="no-users" style="display: none;">
        <p>Henüz kullanıcı bulunmuyor.</p>
      </div>
    </div>
  </div>
</PageLayout>

<style>
  .admin-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  .card {
    background: #ffffff;
    border-radius: 16px;
    padding: 30px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  }

  html[data-theme="dark"] .card {
    background: rgba(14, 21, 37, 0.8);
  }

  .card h3 {
    margin: 0 0 24px 0;
    color: #667eea;
    font-size: 1.3rem;
  }

  .user-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .form-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-group label {
    font-weight: 600;
    color: #333;
  }

  html[data-theme="dark"] .form-group label {
    color: rgba(255, 255, 255, 0.9);
  }

  .form-group input,
  .form-group select {
    padding: 12px 16px;
    border: 2px solid #e0e0e0;
    border-radius: 10px;
    font-size: 16px;
    transition: border-color 0.2s;
  }

  .form-group input:focus,
  .form-group select:focus {
    outline: none;
    border-color: #667eea;
  }

  html[data-theme="dark"] .form-group input,
  html[data-theme="dark"] .form-group select {
    background: rgba(14, 21, 37, 0.6);
    border-color: rgba(102, 126, 234, 0.3);
    color: white;
  }

  .submit-btn {
    padding: 14px 32px;
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: white;
    border: none;
    border-radius: 10px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s;
    align-self: flex-start;
  }

  .submit-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
  }

  .submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }

  .message {
    margin-top: 16px;
    padding: 12px 16px;
    border-radius: 8px;
    font-weight: 500;
  }

  .message.success {
    background: rgba(34, 197, 94, 0.1);
    color: #16a34a;
    border: 1px solid rgba(34, 197, 94, 0.3);
  }

  .message.error {
    background: rgba(239, 68, 68, 0.1);
    color: #dc2626;
    border: 1px solid rgba(239, 68, 68, 0.3);
  }

  .loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 40px;
  }

  .loading-spinner {
    width: 40px;
    height: 40px;
    border: 4px solid rgba(102, 126, 234, 0.2);
    border-top-color: #667eea;
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin { to { transform: rotate(360deg); } }

  .users-table {
    width: 100%;
    border-collapse: collapse;
  }

  .users-table th,
  .users-table td {
    padding: 14px;
    text-align: left;
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  }

  .users-table th {
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: white;
    font-weight: 600;
  }

  html[data-theme="dark"] .users-table td {
    border-bottom-color: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.9);
  }

  .users-table tr:hover {
    background: rgba(102, 126, 234, 0.05);
  }

  .role-badge {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
  }

  .role-badge.admin {
    background: rgba(239, 68, 68, 0.1);
    color: #dc2626;
  }

  .role-badge.sef {
    background: rgba(245, 158, 11, 0.1);
    color: #d97706;
  }

  .role-badge.gar_mudur {
    background: rgba(59, 130, 246, 0.1);
    color: #2563eb;
  }

  .role-badge.personel {
    background: rgba(34, 197, 94, 0.1);
    color: #16a34a;
  }

  .status-badge {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
  }

  .status-badge.active {
    background: rgba(34, 197, 94, 0.1);
    color: #16a34a;
  }

  .status-badge.inactive {
    background: rgba(156, 163, 175, 0.1);
    color: #6b7280;
  }

  .action-btn {
    padding: 6px 12px;
    border: none;
    border-radius: 6px;
    font-size: 13px;
    cursor: pointer;
    transition: all 0.2s;
    margin-right: 8px;
  }

  .action-btn.edit {
    background: rgba(102, 126, 234, 0.1);
    color: #667eea;
  }

  .action-btn.delete {
    background: rgba(239, 68, 68, 0.1);
    color: #dc2626;
  }

  .action-btn:hover {
    transform: translateY(-1px);
  }

  .no-users {
    text-align: center;
    padding: 40px;
    color: #666;
  }

  @media (max-width: 768px) {
    .admin-container {
      padding: 10px;
    }

    .card {
      padding: 20px;
    }

    .users-table {
      font-size: 14px;
    }

    .users-table th,
    .users-table td {
      padding: 10px;
    }

    .action-btn {
      padding: 4px 8px;
      font-size: 12px;
    }
  }
</style>

<script>
  const addUserForm = document.getElementById('addUserForm') as HTMLFormElement;
  const addUserMessage = document.getElementById('addUserMessage') as HTMLDivElement;
  const loadingUsers = document.getElementById('loadingUsers') as HTMLDivElement;
  const userList = document.getElementById('userList') as HTMLDivElement;
  const usersTableBody = document.getElementById('usersTableBody') as HTMLTableSectionElement;
  const noUsers = document.getElementById('noUsers') as HTMLDivElement;

  interface User {
    id: string;
    email: string;
    name: string;
    role: string;
    is_active: boolean;
    created_at: string;
  }

  async function loadUsers() {
    loadingUsers.style.display = 'flex';
    userList.style.display = 'none';
    noUsers.style.display = 'none';

    try {
      const response = await fetch('/api/admin/users');
      if (!response.ok) {
        throw new Error('Kullanıcılar yüklenemedi');
      }

      const users: User[] = await response.json();
      
      if (users.length === 0) {
        loadingUsers.style.display = 'none';
        noUsers.style.display = 'block';
        return;
      }

      usersTableBody.innerHTML = users.map(user => `
        <tr>
          <td>${user.email}</td>
          <td>${user.name}</td>
          <td><span class="role-badge ${user.role}">${user.role}</span></td>
          <td><span class="status-badge ${user.is_active ? 'active' : 'inactive'}">${user.is_active ? 'Aktif' : 'Pasif'}</span></td>
          <td>${new Date(user.created_at).toLocaleDateString('tr-TR')}</td>
          <td>
            <button class="action-btn edit" data-id="${user.id}" data-action="toggle">
              ${user.is_active ? 'Pasifleştir' : 'Aktifleştir'}
            </button>
            <button class="action-btn delete" data-id="${user.id}" data-action="delete">Sil</button>
          </td>
        </tr>
      `).join('');

      // Attach event listeners
      document.querySelectorAll('.action-btn').forEach(btn => {
        btn.addEventListener('click', handleUserAction);
      });

      loadingUsers.style.display = 'none';
      userList.style.display = 'block';
    } catch (error) {
      console.error('Error loading users:', error);
      loadingUsers.style.display = 'none';
      noUsers.innerHTML = '<p>Kullanıcılar yüklenirken hata oluştu.</p>';
      noUsers.style.display = 'block';
    }
  }

  async function handleUserAction(e: Event) {
    const btn = e.target as HTMLButtonElement;
    const userId = btn.dataset.id;
    const action = btn.dataset.action;

    if (action === 'delete') {
      if (!confirm('Bu kullanıcıyı silmek istediğinizden emin misiniz?')) {
        return;
      }

      try {
        const response = await fetch(`/api/admin/users/${userId}`, {
          method: 'DELETE'
        });

        if (response.ok) {
          loadUsers();
        } else {
          alert('Kullanıcı silinemedi');
        }
      } catch (error) {
        alert('Bir hata oluştu');
      }
    } else if (action === 'toggle') {
      try {
        const response = await fetch(`/api/admin/users/${userId}/toggle`, {
          method: 'POST'
        });

        if (response.ok) {
          loadUsers();
        } else {
          alert('Durum değiştirilemedi');
        }
      } catch (error) {
        alert('Bir hata oluştu');
      }
    }
  }

  addUserForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const submitBtn = addUserForm.querySelector('button[type="submit"]') as HTMLButtonElement;
    submitBtn.disabled = true;
    
    const formData = new FormData(addUserForm);
    const data = {
      email: formData.get('email'),
      name: formData.get('name'),
      password: formData.get('password'),
      role: formData.get('role')
    };

    try {
      const response = await fetch('/api/admin/users', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });

      if (response.ok) {
        addUserMessage.textContent = 'Kullanıcı başarıyla eklendi!';
        addUserMessage.className = 'message success';
        addUserMessage.style.display = 'block';
        addUserForm.reset();
        loadUsers();
      } else {
        const error = await response.json();
        throw new Error(error.error || 'Kullanıcı eklenemedi');
      }
    } catch (error) {
      addUserMessage.textContent = error instanceof Error ? error.message : 'Bir hata oluştu';
      addUserMessage.className = 'message error';
      addUserMessage.style.display = 'block';
    } finally {
      submitBtn.disabled = false;
      setTimeout(() => {
        addUserMessage.style.display = 'none';
      }, 5000);
    }
  });

  // Initial load
  loadUsers();
</script>
