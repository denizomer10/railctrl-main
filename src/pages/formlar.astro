---
import PageLayout from '../layouts/PageLayout.astro';

const formlar = [
  { title: 'İzin İsteği (8005)', description: 'Yıllık, mazeret, hastalık veya ücretsiz izin formu', icon: '📅', color: '#0ea5e9', href: '/izin-istegi' },
  { title: 'Doğum Yardımı Formu', description: 'Doğum yardımı başvuru formu', icon: '👶', color: '#ec4899', href: '/files/dogum-yardim.pdf' },
  { title: 'Kimlik Talep - Çalışan (EK-2)', description: 'Çalışanlar için kimlik talep formu', icon: '🪪', color: '#3b82f6', href: '/files/kimlik-talep-ek-2-calisan.pdf' },
  { title: 'Kimlik Talep - Emekli (EK-3)', description: 'Emekliler için kimlik talep formu', icon: '🎫', color: '#8b5cf6', href: '/files/kimlik-talep-ek-3-emekli.pdf' },
  { title: 'Kimlik Talep - Aile (EK-4)', description: 'Aile tanıtım kartı talep formu', icon: '👨‍👩‍👧', color: '#06b6d4', href: '/files/kimlik-talep-ek-4-aile-tanitim.pdf' },
  { title: 'Periyodik Muayene Formu', description: 'Sağlık periyodik muayene formu', icon: '🏥', color: '#10b981', href: '/files/Periyodik Muayene.pdf' },
  { title: 'Lojman Başvuru Formu', description: 'Lojman tahsis başvuru formu', icon: '🏠', color: '#f59e0b', href: '/files/lojman-basvuru.pdf' },
  { title: 'Çalışma İzin Formu', description: 'Çalışma izni talep formu', icon: '📝', color: '#6366f1', href: '/files/calisma-izin-formu.pdf' },
  { title: 'Aile Beyannamesi', description: 'Aile beyannamesi formu', icon: '👪', color: '#14b8a6', href: '/files/aile-beyannamesi.pdf' }
];
---

<PageLayout title="Formlar">
  <div class="forms-page">
    <div class="page-header">
      <div class="header-icon">📝</div>
      <div>
        <h1>Formlar</h1>
        <p>Personel işlemleri için gerekli form ve belgelere erişin</p>
      </div>
    </div>

    <div class="forms-grid">
      {formlar.map((form) => (
        <a class="form-card" href={form.href} target={form.href.endsWith('.pdf') ? '_blank' : undefined} rel={form.href.endsWith('.pdf') ? 'noopener noreferrer' : undefined} style={`--card-color: ${form.color}`}>
          <div class="card-icon">{form.icon}</div>
          <div class="card-content">
            <h2>{form.title}</h2>
            <p>{form.description}</p>
          </div>
          <span class="card-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </div>
</PageLayout>

<style>
  .forms-page { max-width: 1200px; margin: 0 auto; }
  .page-header { display: flex; align-items: center; justify-content: center; gap: 1rem; text-align: left; margin-bottom: 2rem; }
  .header-icon { font-size: 3rem; }
  .page-header h1 { margin: 0; color: #1f2937; font-size: 1.75rem; }
  .page-header p { margin: .25rem 0 0; color: #666; }
  .forms-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.25rem; }
  .form-card { display: flex; align-items: center; gap: 1rem; position: relative; overflow: hidden; padding: 1.25rem; border: 1px solid #e5e7eb; border-radius: 16px; background: #fff; color: inherit; text-decoration: none; transition: all .3s ease; }
  .form-card::before { content: ''; position: absolute; inset: 0 auto 0 0; width: 4px; background: var(--card-color); }
  .form-card:hover { transform: translateY(-4px); border-color: var(--card-color); box-shadow: 0 12px 30px rgba(0,0,0,.12); }
  .card-icon { display: flex; align-items: center; justify-content: center; width: 56px; height: 56px; flex-shrink: 0; border-radius: 14px; background: #f1f5f9; font-size: 1.75rem; }
  .card-content { flex: 1; min-width: 0; }
  .card-content h2 { margin: 0 0 .25rem; color: #1f2937; font-size: 1rem; }
  .card-content p { margin: 0; color: #6b7280; font-size: .85rem; }
  .card-arrow { color: #9ca3af; font-size: 1.5rem; transition: transform .3s ease; }
  .form-card:hover .card-arrow { color: var(--card-color); transform: translateX(4px); }
  :global(html[data-theme="dark"]) .form-card { border-color: #333; background: #1a1a2e; }
  :global(html[data-theme="dark"]) .page-header h1, :global(html[data-theme="dark"]) .card-content h2 { color: #f8fafc; }
  :global(html[data-theme="dark"]) .page-header p, :global(html[data-theme="dark"]) .card-content p { color: #cbd5e1; }
  @media (max-width: 768px) {
    .page-header { flex-direction: column; text-align: center; }
    .forms-grid { grid-template-columns: 1fr; }
  }
</style>
