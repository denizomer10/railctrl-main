---
import PageLayout from '../layouts/PageLayout.astro';

// Marmaray istasyonları

---

<PageLayout title="Arıza Kayıtları">
  <div class="mms-page modern-records-page">
    <!-- Header -->
    <div class="page-header">
      <div class="header-content">
        <div class="header-icon">🔧</div>
        <div class="header-text">
          <h1 data-i18n="problemRecords">Arıza Kayıtları</h1>
          <p data-i18n="problemTracking">Bakım ve arıza takip sistemi</p>
        </div>
      </div>
      <div class="header-actions">
        <button id="reportBtn" class="btn-report">
          <span class="btn-icon">📊</span>
          Rapor Al
        </button>
        <button id="newRecordBtn" class="btn-new">
          <span class="btn-icon">+</span>
          Yeni Kayıt
        </button>
      </div>
    </div>

    <!-- Search & Filters -->
    <div class="toolbar">
      <div class="search-wrapper">
        <span class="search-icon">🔍</span>
        <input type="text" id="searchInput" class="search-input" placeholder="Ara... (MMS No, Arıza, İstasyon)" />
        <button id="searchClear" class="search-clear" style="display: none;">✕</button>
      </div>
      <div class="filter-row">
        <div class="filter-chips">
          <button class="chip active" data-durum="all">Tümü</button>
          <button class="chip" data-durum="">⏳ Beklemede</button>
          <button class="chip" data-durum="Onarıldı">✅ Onarıldı</button>
          <button class="chip" data-durum="Onarılmadı">❌ Onarılmadı</button>
          <button class="chip" data-durum="Onarımda">🔧 Onarımda</button>
          <button class="chip" data-durum="Parça Bekleniyor">📦 Parça Bek.</button>
        </div>
        <div class="filter-station">
          <input id="stationFilter" class="station-select" type="text" placeholder="📍 İstasyon ara" />
        </div>
      </div>
    </div>

    <!-- Stats Bar -->
    <div class="stats-bar">
      <div class="stat-item"><span class="stat-value" id="totalCount">-</span><span class="stat-label">Toplam</span></div>
      <div class="stat-item st-warning"><span class="stat-value" id="bekleyenCount">-</span><span class="stat-label">Beklemede</span></div>
      <div class="stat-item st-success"><span class="stat-value" id="onarilanCount">-</span><span class="stat-label">Onarıldı</span></div>
      <div class="stat-item st-danger"><span class="stat-value" id="onarilmadiCount">-</span><span class="stat-label">Onarılmadı</span></div>
      <div class="stat-item st-info"><span class="stat-value" id="onarimdaCount">-</span><span class="stat-label">Onarımda</span></div>
    </div>

    <!-- Table Container -->
    <div class="table-container">
      <table class="data-table">
        <thead>
          <tr>
            <th>MMS No</th>
            <th>Tarih</th>
            <th>Arıza Tanımı</th>
            <th>İstasyon</th>
            <th>Bildiren</th>
            <th>Durum</th>
            <th>İşlem</th>
          </tr>
        </thead>
        <tbody id="tableBody">
          <tr class="loading-row">
            <td colspan="7">
              <div class="loading-state"><div class="spinner"></div><span>Yükleniyor...</span></div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- No Results -->
    <div id="noResults" class="no-results" style="display: none;">
      <div class="no-results-icon">🔍</div>
      <h3>Sonuç Bulunamadı</h3>
    </div>

    <!-- Load More -->
    <div id="paginationContainer" class="pagination-container" style="display: none;"></div>
  </div>

  <!-- Modal -->
  <div id="recordModal" class="modal" style="display: none;">
    <div class="modal-box">
      <div class="modal-header">
        <h3 id="modalTitle">Yeni MMS Kaydı</h3>
        <button id="closeModal" class="modal-close">✕</button>
      </div>
      <form id="recordForm">
        <input type="hidden" id="recordId" />
        <div class="form-grid">
          <div class="form-group">
            <label>MMS Numarası *</label>
            <input type="text" id="mms_numarasi" required placeholder="Örn: 273210" />
          </div>
          <div class="form-group">
            <label>İstasyon *</label>
            <input type="text" id="istasyon" required />
          </div>
        </div>
        <div class="form-group">
          <label>Arıza Tanımı *</label>
          <textarea id="ariza_tanimi" rows="3" required placeholder="Arıza detayını yazın..."></textarea>
        </div>
        <div class="form-group" id="durumGroup" style="display: none;">
          <label>Durum</label>
          <select id="durum">
            <option value="">⏳ Beklemede</option>
            <option value="Onarıldı">✅ Onarıldı</option>
            <option value="Onarılmadı">❌ Onarılmadı</option>
            <option value="Onarımda">🔧 Onarımda</option>
            <option value="Parça Bekleniyor">📦 Parça Bekleniyor</option>
          </select>
        </div>
        <div class="form-group" id="notGroup" style="display: none;">
          <label>Not <span class="optional-label">(Opsiyonel)</span></label>
          <textarea id="not" rows="2" placeholder="Durumla ilgili not ekleyin..."></textarea>
        </div>
        <div id="formMessage" class="form-message" style="display: none;"></div>
        <div class="form-actions">
          <button type="button" id="deleteRecordBtn" class="btn-delete" style="display: none;">Sil</button>
          <div class="form-actions-right">
            <button type="button" id="cancelBtn" class="btn-cancel">İptal</button>
            <button type="submit" class="btn-submit">Kaydet</button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <!-- Rapor Modal -->
  <div id="reportModal" class="modal" style="display: none;">
    <div class="modal-box report-modal-box">
      <div class="modal-header">
        <h3>📊 MMS Raporu Oluştur</h3>
        <button id="closeReportModal" class="modal-close">✕</button>
      </div>
      <div class="report-form">
        <div id="reportDateRangeRow" class="form-grid">
          <div class="form-group">
            <label>Başlangıç Tarihi</label>
            <input type="date" id="reportStartDate" />
          </div>
          <div class="form-group">
            <label>Bitiş Tarihi</label>
            <input type="date" id="reportEndDate" />
          </div>
        </div>
        <div class="form-group">
          <label style="display:flex;align-items:center;gap:.45rem;cursor:pointer;">
            <input type="checkbox" id="reportAllDates" />
            Tüm Tarihler
          </label>
        </div>
        <div class="form-grid">
          <div class="form-group">
            <label>İstasyon</label>
            <input id="reportStation" type="text" placeholder="İstasyon" />
          </div>
          <div class="form-group">
            <label>Durum</label>
            <select id="reportDurum">
              <option value="">Tümü</option>
              <option value="Beklemede">⏳ Beklemede</option>
              <option value="Onarıldı">✅ Onarıldı</option>
              <option value="Onarılmadı">❌ Onarılmadı</option>
              <option value="Onarımda">🔧 Onarımda</option>
              <option value="Parça Bekleniyor">📦 Parça Bekleniyor</option>
            </select>
          </div>
        </div>
        
        <div class="form-actions">
          <button type="button" id="downloadPdfBtn" class="btn-submit">📄 PDF Oluştur</button>
        </div>
      </div>
    </div>
  </div>

<script>
  import { initMms } from '../scripts/problem-records';
  initMms();
</script>
</PageLayout>

<style>
  .mms-page { max-width: 100%; }
  
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .header-content { display: flex; align-items: center; gap: 0.75rem; }
  .header-icon { font-size: 2rem; }
  .header-text h1 { font-size: 1.4rem; font-weight: 700; margin: 0; }
  .header-text p { color: #666; margin: 0.2rem 0 0; font-size: 0.85rem; }
  [data-theme="dark"] .header-text p { color: #999; }

  .header-actions { display: flex; gap: 0.75rem; }

  .btn-report {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 1rem;
    background: linear-gradient(135deg, #10b981, #059669);
    color: white;
    border: none;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.85rem;
    cursor: pointer;
  }
  .btn-report:hover { filter: brightness(1.1); }

  .btn-new {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 1rem;
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: white;
    border: none;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.85rem;
    cursor: pointer;
  }
  .btn-new:hover { opacity: 0.9; }
  .btn-icon { font-size: 1.1rem; font-weight: bold; }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1rem;
    align-items: stretch;
    width: 100%;
  }
  .search-wrapper {
    position: relative;
    flex: 1;
    min-width: 0;
    max-width: 100%;
  }
  .search-icon {
    position: absolute;
    left: 0.9rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1rem;
    line-height: 1;
    pointer-events: none;
    z-index: 1;
  }
  .search-input {
    width: 100%;
    padding: 0.65rem 2.2rem 0.65rem 2.8rem;
    border: 1px solid #ddd;
    border-radius: 8px;
    background: #fff;
    font-size: 0.9rem;
    box-sizing: border-box;
  }
  [data-theme="dark"] .search-input { background: #1a1a1a; border-color: #333; color: #fff; }
  .search-input:focus { outline: none; border-color: #667eea; }
  .search-clear {
    position: absolute;
    right: 0.5rem;
    top: 50%;
    transform: translateY(-50%);
    background: #ddd;
    border: none;
    border-radius: 50%;
    width: 20px;
    height: 20px;
    z-index: 2;
    font-size: 0.7rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .filter-row { display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; justify-content: space-between; width: 100%; min-width: 0; }
  .filter-chips { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .filter-station { flex-shrink: 0; }
  .station-select {
    padding: 0.5rem 2rem 0.5rem 1rem;
    border: 1px solid #ddd;
    border-radius: 8px;
    background: #fff;
    font-size: 0.85rem;
    cursor: pointer;
    appearance: none;
    background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23667eea' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: right 0.7rem center;
    background-size: 14px;
    min-width: 180px;
  }
  :global(html[data-theme="dark"]) .station-select {
    background-color: #0b1220;
    border-color: #334155;
    color: #e5e7eb;
    color-scheme: dark;
    background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2393c5fd' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
  }
  :global(html[data-theme="dark"]) .station-select option {
    background: #0b1220;
    color: #e5e7eb;
  }
  :global(html[data-theme="dark"]) .station-select option:checked {
    background: #1e3a8a;
    color: #dbeafe;
  }
  .station-select:focus { outline: none; border-color: #667eea; }
  .chip {
    padding: 0.4rem 0.7rem;
    border: 1px solid #ddd;
    border-radius: 6px;
    background: #fff;
    font-size: 0.8rem;
    cursor: pointer;
    white-space: nowrap;
  }
  [data-theme="dark"] .chip { background: #1a1a1a; border-color: #333; color: #ccc; }
  .chip:hover { border-color: #667eea; }
  .chip.active { background: #667eea; border-color: #667eea; color: white; }

  .stats-bar { display: flex; gap: 0.5rem; margin-bottom: 1rem; flex-wrap: wrap; }
  .stat-item {
    background: #fff;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    padding: 0.5rem 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  [data-theme="dark"] .stat-item { background: #1a1a1a; border-color: #333; }
  .stat-value { font-size: 1.1rem; font-weight: 700; color: #667eea; }
  .stat-label { color: #888; font-size: 0.75rem; }
  .st-warning .stat-value { color: #f59e0b; }
  .st-success .stat-value { color: #10b981; }
  .st-danger .stat-value { color: #ef4444; }
  .st-info .stat-value { color: #3b82f6; }

  .table-container {
    background: #fff;
    border: 1px solid #e0e0e0;
    border-radius: 10px;
    overflow: hidden;
  }
  [data-theme="dark"] .table-container { background: #1a1a1a; border-color: #333; }

  .data-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
  .data-table thead { background: linear-gradient(135deg, #667eea, #764ba2); color: white; }
  .data-table th { padding: 0.75rem; text-align: left; font-weight: 600; font-size: 0.8rem; }
  .data-table tbody tr { border-bottom: 1px solid #e0e0e0; }
  [data-theme="dark"] .data-table tbody tr { border-color: #333; }
  .data-table tbody tr:hover { background: #f8f9ff; }
  [data-theme="dark"] .data-table tbody tr:hover { background: #1e1e2e; }
  .data-table td { padding: 0.6rem 0.75rem; vertical-align: middle; }

  .mms-no { font-weight: 700; color: #667eea; font-family: monospace; }
  [data-theme="dark"] .mms-no { color: #a5b4fc; }
  .date-cell { color: #666; font-size: 0.8rem; white-space: nowrap; }
  .date-cell small { display: block; margin-top: 0.2rem; color: #15803d; font-size: 0.72rem; }
  .mms-note { margin-top: 0.35rem; color: #64748b; font-size: 0.78rem; white-space: pre-wrap; }
  .optional-label { color: #64748b; font-size: 0.78rem; font-weight: normal; }
  [data-theme="dark"] .date-cell { color: #aaa; }
  .ariza-cell { max-width: 280px; line-height: 1.3; }
  [data-theme="dark"] .ariza-cell { color: #e0e0e0; }
  .istasyon-cell { font-weight: 500; }
  [data-theme="dark"] .istasyon-cell { color: #e0e0e0; }
  [data-theme="dark"] .data-table td { color: #e0e0e0; }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
  }
  .status-warning { background: #fef3c7; color: #92400e; }
  .status-success { background: #d1fae5; color: #065f46; }
  .status-danger { background: #fee2e2; color: #991b1b; }
  .status-info { background: #dbeafe; color: #1e40af; }
  .status-purple { background: #ede9fe; color: #5b21b6; }
  [data-theme="dark"] .status-warning { background: #451a03; color: #fcd34d; }
  [data-theme="dark"] .status-success { background: #064e3b; color: #6ee7b7; }
  [data-theme="dark"] .status-danger { background: #450a0a; color: #fca5a5; }
  [data-theme="dark"] .status-info { background: #1e3a8a; color: #93c5fd; }
  [data-theme="dark"] .status-purple { background: #2e1065; color: #c4b5fd; }

  .action-btns { display: flex; gap: 0.3rem; }
  .btn-action {
    padding: 0.3rem 0.5rem;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.75rem;
  }
  .btn-edit { background: #dbeafe; color: #1e40af; }
  .btn-edit:hover { background: #bfdbfe; }
  [data-theme="dark"] .btn-edit { background: #1e3a5f; color: #93c5fd; }

  .loading-row td { padding: 2rem; }
  .loading-state { display: flex; align-items: center; justify-content: center; gap: 0.5rem; color: #888; }
  .spinner {
    width: 20px;
    height: 20px;
    border: 2px solid #e0e0e0;
    border-top-color: #667eea;
    border-radius: 50%;
    animation: spin 0.6s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  .no-results { text-align: center; padding: 2rem; }
  [data-theme="dark"] .no-results { color: #ccc; }
  .no-results-icon { font-size: 2rem; margin-bottom: 0.5rem; }
  .no-results h3 { margin: 0; font-size: 1rem; }
  [data-theme="dark"] .no-results h3 { color: #e0e0e0; }

   :global(.pagination-container) { display: flex; justify-content: center; gap: 0.45rem; margin-top: 1rem; flex-wrap: wrap; }
   :global(.page-btn) {
    min-width: 36px;
    height: 36px;
    border: 1px solid #d1d5db;
    border-radius: 10px;
    background: #fff;
    color: #334155;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
  }
   :global(.page-btn:hover) { border-color: #667eea; color: #4338ca; }
   :global(.page-btn.active) { background: linear-gradient(135deg, #667eea, #764ba2); color: #fff; border-color: transparent; }
  [data-theme="dark"]  :global(.page-btn) { background: #111827; color: #d1d5db; border-color: #374151; }
  [data-theme="dark"]  :global(.page-btn.active) { background: linear-gradient(135deg, #667eea, #764ba2); color: #fff; border-color: transparent; }

  /* Modal */
  .modal {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.55);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 12000;
    padding: 1rem;
  }
  .modal-box {
    background: #fff;
    border-radius: 12px;
    width: 100%;
    max-width: 480px;
    max-height: 85vh;
    overflow-y: auto;
    box-shadow: 0 10px 40px rgba(0,0,0,0.2);
  }
  [data-theme="dark"] .modal-box { background: #1a1a1a; }
  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem;
    border-bottom: 1px solid #e0e0e0;
  }
  [data-theme="dark"] .modal-header { border-color: #333; }
  .modal-header h3 { margin: 0; font-size: 1.1rem; }
  [data-theme="dark"] .modal-header h3 { color: #e0e0e0; }
  .modal-close {
    background: #f0f0f0;
    border: none;
    border-radius: 6px;
    width: 28px;
    height: 28px;
    cursor: pointer;
    font-size: 0.9rem;
  }
  [data-theme="dark"] .modal-close { background: #333; color: #ccc; }
  .modal-close:hover { background: #fee2e2; color: #dc2626; }

  #recordForm { padding: 1rem; }
  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  .form-group { margin-bottom: 0.75rem; }
  .form-group label { display: block; margin-bottom: 0.3rem; font-weight: 600; font-size: 0.8rem; }
  [data-theme="dark"] .form-group label { color: #ccc; }
  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: 0.6rem 0.75rem;
    border: 1px solid #ddd;
    border-radius: 6px;
    background: #fff;
    font-size: 0.9rem;
  }
  [data-theme="dark"] .form-group input,
  [data-theme="dark"] .form-group select,
  [data-theme="dark"] .form-group textarea { background: #0a0a0a; border-color: #333; color: #fff; }
  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus { outline: none; border-color: #667eea; }
  .form-group textarea { resize: vertical; min-height: 80px; font-family: inherit; }

  .form-message {
    padding: 0.6rem;
    border-radius: 6px;
    text-align: center;
    font-size: 0.85rem;
    margin-bottom: 0.75rem;
  }
  .form-message.success { background: #d1fae5; color: #065f46; }
  .form-message.error { background: #fee2e2; color: #991b1b; }

  /* Rapor Modal */
  .report-modal-box { max-width: 550px; }
  .report-form { padding: 1rem; }
  .report-form input[type="date"] { cursor: pointer; padding-right: 0.75rem; }
  .report-form input[type="date"]::-webkit-calendar-picker-indicator {
    opacity: 0;
    display: none;
    -webkit-appearance: none;
  }

  .modal-box,
  .report-modal-box {
    overflow-x: hidden;
    box-sizing: border-box;
  }

  #recordForm,
  .report-form,
  .form-grid,
  .form-group,
  .form-actions,
  .form-actions-right {
    min-width: 0;
    box-sizing: border-box;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    max-width: 100%;
    box-sizing: border-box;
  }

  .form-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 0.75rem;
    border-top: 1px solid #e0e0e0;
  }
  [data-theme="dark"] .form-actions { border-color: #333; }
  .form-actions-right { display: flex; gap: 0.5rem; }
  .btn-cancel {
    padding: 0.6rem 1rem;
    background: #f0f0f0;
    border: none;
    border-radius: 6px;
    font-weight: 600;
    cursor: pointer;
  }
  [data-theme="dark"] .btn-cancel { background: #333; color: #ccc; }
