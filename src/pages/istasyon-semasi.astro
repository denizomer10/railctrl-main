---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="İstasyon Şeması">
  <section class="istasyon-section">
    <header class="istasyon-header">
      <div class="istasyon-copy">
        <h2 data-pages="title">İstasyon Şeması</h2>
      </div>
    </header>

    <div class="station-dropdown-container">
      <label for="station-select">İstasyon Seçin:</label>
      <select id="station-select" class="station-select">
        <option value="">Seçiniz...</option>
        <option value="atalar">Atalar</option>
        <option value="aydintepe">Aydıntepe</option>
        <option value="basak">Başak</option>
        <option value="bostanci-dogu-konkors">Bostancı Doğu Konkors</option>
        <option value="bostanci-peron-bati-konkors">Bostancı Peron Batı Konkors</option>
        <option value="cayirova">Çayırova</option>
        <option value="cevizli">Cevizli</option>
        <option value="darica">Darica</option>
        <option value="erenkoy">Erenköy</option>
        <option value="fatih">Fatih</option>
        <option value="feneryolu">Feneryolu</option>
        <option value="gebze-konkors">Gebze Konkors</option>
        <option value="gebze-peron">Gebze Peron</option>
        <option value="goztepe">Göztepe</option>
        <option value="guzelyali">Güzelyalı</option>
        <option value="icmeler">İçmeler</option>
        <option value="idealtepe">İdealtepe</option>
        <option value="kartal">Kartal</option>
        <option value="kaynarca">Kaynarca</option>
        <option value="kücükyali">Küçükyalı</option>
        <option value="maltepe">Maltepe</option>
        <option value="osmangazi">Osman Gazi</option>
        <option value="pendik">Pendik</option>
        <option value="sogutlucesme">Söğütlüçeşme</option>
        <option value="suadiye">Suadiye</option>
        <option value="sureyya-plaji">Süreyya Plajı</option>
        <option value="tersane">Tersane</option>
        <option value="tuzla">Tuzla</option>
        <option value="yunus">Yunus</option>
      </select>
    </div>

    <div class="istasyon-viewer" id="istasyon-viewer" style="display:none;">
      <div class="viewer-header">
        <h3 id="current-station-name">İstasyon Şeması</h3>
        <button type="button" id="close-viewer-btn" class="close-viewer-btn" aria-label="Kapat">✕</button>
      </div>
      <div class="istasyon-image-wrap" id="istasyon-image-wrap">
        <img
          id="istasyon-image"
          src=""
          alt="İstasyon Şeması"
          decoding="async"
          loading="lazy"
        />
      </div>
      <div class="zoom-indicator" id="zoom-indicator">100%</div>
    </div>
  </section>

<script>
  import { initIstasyonSemasi } from '../scripts/istasyon-semasi';
  initIstasyonSemasi();
</script>
</PageLayout>

<style>
  .istasyon-section {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .istasyon-header {
    display: flex;
    justify-content: center;
  }

  .istasyon-copy {
    width: 100%;
  }

  .istasyon-copy h2 {
    margin: 0;
    padding: 0.8rem 1.1rem;
    font-size: 2rem;
    font-weight: 700;
    text-align: center;
    border-radius: 14px;
    border: 1px solid rgba(148, 163, 184, 0.35);
    background: rgba(255, 255, 255, 0.42);
    box-shadow: 0 12px 26px rgba(15, 23, 42, 0.14);
    backdrop-filter: blur(12px) saturate(145%);
    -webkit-backdrop-filter: blur(12px) saturate(145%);
  }

  .station-dropdown-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin: 0.2rem 0 0.7rem;
  }

  .station-dropdown-container label {
    margin-bottom: 10px;
    font-weight: 600;
    font-size: 1rem;
  }

  .station-select {
    width: 100%;
    max-width: 350px;
    padding: 14px 18px;
    font-size: 16px;
    border: 2px solid #d1d5db;
    border-radius: 12px;
    background: #fff;
    color: #111827;
    cursor: pointer;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .station-select:focus {
    outline: none;
    border-color: #2563eb;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.16);
  }

  .istasyon-viewer {
    width: 100%;
    min-height: 420px;
    height: 72vh;
    max-height: 80vh;
    border-radius: 16px;
    border: 1px solid rgba(148, 163, 184, 0.35);
    background: rgba(255, 255, 255, 0.42);
    box-shadow: 0 16px 34px rgba(15, 23, 42, 0.15);
    overflow: hidden;
    position: relative;
    cursor: grab;
    touch-action: none;
  }

  .istasyon-viewer.dragging {
    cursor: grabbing;
  }

  .viewer-header {
    padding: 12px 18px;
    border-bottom: 1px solid rgba(148, 163, 184, 0.35);
    background: rgba(255, 255, 255, 0.62);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .viewer-header h3 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
  }

  .istasyon-image-wrap {
    box-sizing: border-box;
    padding: 12px;
    height: calc(100% - 56px);
    overflow: auto;
    cursor: inherit;
  }

  .istasyon-image-wrap img {
    width: auto;
    max-width: none;
    height: auto;
    margin: 0 auto;
    display: block;
    border-radius: 10px;
    border: 1px solid rgba(148, 163, 184, 0.25);
    image-rendering: auto;
    user-select: none;
    -webkit-user-drag: none;
    pointer-events: none;
  }

  .close-viewer-btn {
    width: 32px;
    height: 32px;
    border: 1px solid rgba(148, 163, 184, 0.5);
    border-radius: 8px;
    background: rgba(239, 68, 68, 0.9);
    color: #fff;
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
  }

  .zoom-indicator {
    position: absolute;
    right: 14px;
    bottom: 58px;
    background: rgba(15, 23, 42, 0.82);
    color: #fff;
    border-radius: 999px;
    padding: 6px 10px;
    font-size: 0.76rem;
    font-weight: 700;
    opacity: 0;
    transition: opacity 0.2s ease;
    pointer-events: none;
  }

  .zoom-indicator.show {
    opacity: 1;
  }

  html[data-theme="dark"] .istasyon-copy h2 {
    background: rgba(15, 23, 42, 0.56);
    border-color: rgba(148, 163, 184, 0.28);
    box-shadow: 0 18px 34px rgba(2, 6, 23, 0.45);
  }

  html[data-theme="dark"] .station-dropdown-container label,
  html[data-theme="dark"] .viewer-header h3 {
    color: #e5e7eb;
  }

  html[data-theme="dark"] .station-select {
    background: #1e293b;
    color: #f8fafc;
    border-color: rgba(148, 163, 184, 0.35);
  }

  html[data-theme="dark"] .istasyon-viewer {
    background: rgba(15, 23, 42, 0.5);
    border-color: rgba(148, 163, 184, 0.3);
  }

  html[data-theme="dark"] .viewer-header {
    background: rgba(15, 23, 42, 0.62);
  }

  @media (max-width: 768px) {
    .station-select {
      max-width: 320px;
    }

    .istasyon-viewer {
      height: 64vh;
      min-height: 320px;
    }
  }
</style>

