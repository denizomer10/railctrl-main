---
import HomeLayout from '../layouts/HomeLayout.astro';
const user = Astro.locals.user;

// Kullanıcı giriş yapmamışsa login'e yönlendir
if (!user) {
  return Astro.redirect('/login');
}

// Kullanıcı adını parçalara ayır (isim ve soyisim için)
const displayName = user.displayName || user.email?.split('@')[0] || 'Yönetici';
const nameParts = displayName.split(' ');
const firstName = nameParts[0] || 'Yönetici';
const lastName = nameParts.slice(1).join(' ') || '';
---

<HomeLayout title="Ana Sayfa">
  <div class="welcome-section">
    <div class="welcome-content">
      <h1 data-pages="title">
        <span class="train-icon">🚆</span>
        <span class="welcome-text">Hoş Geldiniz</span>
        <span class="user-name">
          <span class="first-name">{firstName}</span>
          {lastName && <span class="last-name">{lastName}</span>}
        </span>
        <span class="exclamation">!</span>
      </h1>
      <p class="welcome-subtitle">
        Yukarıdaki menüyü kullanarak TCDD Yönetim Sistemine erişebilirsiniz.
      </p>
    </div>
  </div>
</HomeLayout>

<style>
  .welcome-section {
    text-align: center;
    margin-bottom: 2rem;
    padding: 2rem 1rem;
  }

  .welcome-content h1 {
    font-size: 2rem;
    margin-bottom: 1rem;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    font-weight: 300;
    letter-spacing: 0.5px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .train-icon {
    font-size: 2.2rem;
  }

  .welcome-text {
    color: #111827;
    font-weight: 400;
  }

  .user-name {
    color: #0f172a;
    font-weight: 600;
    display: inline-flex;
    gap: 0.25rem;
  }

  .first-name {
    color: #0f172a;
    font-weight: 700;
  }

  .last-name {
    color: #0f172a;
    font-weight: 700;
  }

  .exclamation {
    color: #0f172a;
    font-weight: 600;
  }

  :global(html[data-theme="dark"]) .welcome-text,
  :global(html[data-theme="dark"]) .user-name,
  :global(html[data-theme="dark"]) .first-name,
  :global(html[data-theme="dark"]) .last-name,
  :global(html[data-theme="dark"]) .exclamation {
    color: #ffffff;
  }

  .welcome-subtitle {
    font-size: 1rem;
    color: var(--text-color);
    opacity: 0.8;
    max-width: 500px;
    margin: 0 auto;
    line-height: 1.5;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    font-weight: 300;
  }

  @keyframes train-move {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(5px); }
  }

  @media (max-width: 768px) {
    .welcome-content h1 {
      font-size: 1.25rem;
      flex-direction: column;
      gap: 0.25rem;
    }

    .train-icon {
      font-size: 1.5rem;
    }

    .welcome-subtitle {
      font-size: 0.9rem;
    }
  }

  @media (max-width: 480px) {
    .welcome-content h1 {
      font-size: 1.1rem;
      gap: 0.2rem;
    }

    .train-icon {
      font-size: 1.3rem;
    }

    .welcome-subtitle {
      font-size: 0.85rem;
    }
  }
</style>
