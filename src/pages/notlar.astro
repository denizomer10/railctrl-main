---
import PageLayout from '../layouts/PageLayout.astro';
import { MARMARAY_ISTASYONLARI } from '../lib/stations';

const user = Astro.locals.user;
const canSeePrivate = user?.role === 'admin' || user?.role === 'sef' || user?.role === 'gar_mudur';
---

<PageLayout title="Notlar">
  <div class="notlar-page modern-records-page">
    <!-- Header -->
    <div class="page-header">
      <div class="header-content">
        <div class="header-icon">📝</div>
        <div class="header-text">
          <h1>Notlar</h1>
          <p>Önemli bilgiler, prosedürler ve şifreler</p>
        </div>
      </div>
      <button id="newNoteBtn" class="btn-new">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        Yeni Not
      </button>
    </div>

    <!-- Search & Filters -->
    <div class="toolbar">
      <div class="search-wrapper">
        <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
        <input type="text" id="searchInput" class="search-input" placeholder="Ara... (Başlık, İçerik)" />
        <div id="searchClear" class="search-clear" style="display: none;">✕</div>
      </div>
      <div class="filter-chips">
        <button class="chip active" data-kategori="">Tümü</button>
        <button class="chip" data-kategori="Prosedür">📋 Prosedür</button>
        <button class="chip" data-kategori="Şifre">🔐 Şifre</button>
        <button class="chip" data-kategori="Adres">📍 Adres</button>
        <button class="chip" data-kategori="Vardiya">⏰ Vardiya</button>
        <button class="chip" data-kategori="Genel">📌 Genel</button>
        {canSeePrivate && <button class="chip" data-kategori="Özel">🔒 Özel</button>}
      </div>
      <select id="stationFilter" class="station-filter">
        <option value="">Tüm İstasyonlar</option>
        {MARMARAY_ISTASYONLARI.map((istasyon) => (
          <option value={istasyon}>{istasyon}</option>
        ))}
      </select>
    </div>

    <!-- Stats Bar -->
    <div class="stats-bar">
      <div class="stat-item">
        <span class="stat-value" id="totalCount">-</span>
        <span class="stat-label">Toplam Not</span>
      </div>
    </div>

    <!-- Table Container -->
    <div class="table-container">
      <table class="data-table">
        <thead>
          <tr>
            <th style="width: 200px;">Başlık</th>
            <th style="width: 120px;">Kategori</th>
            <th style="width: 130px;">İstasyon</th>
            <th>İçerik Önizleme</th>
            <th style="width: 150px;">Tarih</th>
            <th style="width: 100px;">İşlem</th>
          </tr>
        </thead>
        <tbody id="tableBody">
          <tr class="loading-row">
            <td colspan="6">
              <div class="loading-state">
                <div class="loading-spinner"></div>
                <span>Yükleniyor...</span>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- No Results -->
    <div id="noResults" class="no-results" style="display: none;">
      <div class="no-results-icon">🔍</div>
      <h3>Sonuç Bulunamadı</h3>
      <p>Arama kriterlerinize uygun not bulunamadı.</p>
    </div>
    <div id="paginationContainer" class="pagination-container" style="display: none;"></div>
  </div>

  <!-- Modal - Yeni Not -->
  <div id="noteModal" class="modal-overlay" style="display: none;">
    <div class="modal-content">
      <div class="modal-header">
        <h3 id="modalTitle">Yeni Not</h3>
        <button id="closeModal" class="btn-close">✕</button>
      </div>
      
      <form id="noteForm" class="note-form">
        <input type="hidden" id="noteId" name="noteId" />
        <div class="form-group">
          <label for="baslik">Başlık *</label>
          <input type="text" id="baslik" name="baslik" required placeholder="Not başlığı" />
        </div>

        <div class="form-group">
          <label for="kategori">Kategori</label>
          <select id="kategori" name="kategori">
            <option value="Genel">📌 Genel</option>
            <option value="Prosedür">📋 Prosedür</option>
            <option value="Şifre">🔐 Şifre</option>
            <option value="Adres">📍 Adres</option>
            <option value="Vardiya">⏰ Vardiya</option>
            {canSeePrivate && <option value="Özel">🔒 Özel</option>}
          </select>
        </div>

        <div class="form-group">
          <label for="noteIstasyon">İstasyon (opsiyonel)</label>
          <select id="noteIstasyon" name="istasyon">
            <option value="">Tüm İstasyonlar</option>
            {MARMARAY_ISTASYONLARI.map((istasyon) => (
              <option value={istasyon}>{istasyon}</option>
            ))}
          </select>
        </div>

        <div class="form-group">
          <label for="icerik">İçerik *</label>
          <div class="editor-tools" id="editorTools">
            <button type="button" data-cmd="bold" title="Kalın"><b>B</b></button>
            <button type="button" data-cmd="italic" title="İtalik"><i>I</i></button>
            <button type="button" data-cmd="underline" title="Altı Çizili"><u>U</u></button>
            <button type="button" data-cmd="strikeThrough" title="Üstü Çizili"><s>S</s></button>
            <button type="button" data-cmd="formatBlock" data-value="h2" title="Başlık">H2</button>
            <button type="button" data-cmd="formatBlock" data-value="h3" title="Alt Başlık">H3</button>
            <button type="button" data-cmd="formatBlock" data-value="blockquote" title="Alıntı">❝</button>
            <button type="button" data-cmd="formatBlock" data-value="pre" title="Kod Blok">{ }</button>
            <button type="button" data-cmd="insertUnorderedList" title="Madde Listesi">• Liste</button>
            <button type="button" data-cmd="insertOrderedList" title="Numaralı Liste">1. Liste</button>
            <button type="button" data-cmd="outdent" title="Girintiyi Azalt">⟵</button>
            <button type="button" data-cmd="indent" title="Girintiyi Artır">⟶</button>
            <button type="button" data-cmd="justifyLeft" title="Sola">⟸</button>
            <button type="button" data-cmd="justifyCenter" title="Ortala">≡</button>
            <button type="button" data-cmd="justifyRight" title="Sağa">⟹</button>
            <button type="button" data-link="true" title="Bağlantı">Link</button>
            <button type="button" data-cmd="unlink" title="Bağlantıyı Kaldır">Unlink</button>
            <button type="button" data-cmd="insertHorizontalRule" title="Ayraç">―</button>
            <label class="toolbar-color">
              A
              <input type="color" id="textColorPicker" value="#e5e7eb" title="Yazı Rengi" />
            </label>
            <label class="toolbar-color">
              Bg
              <input type="color" id="bgColorPicker" value="#fff59d" title="Vurgu Rengi" />
            </label>
            <button type="button" data-resize="down" title="Resmi Küçült">Resim -</button>
            <button type="button" data-resize="up" title="Resmi Büyüt">Resim +</button>
            <button type="button" data-cmd="removeFormat" title="Biçimi Temizle">Tx</button>
          </div>
          <div id="richEditor" class="rich-editor" contenteditable="true" data-placeholder="Not içeriği..."></div>
          <textarea id="icerik" name="icerik" rows="10" style="display: none;"></textarea>
        </div>

        <div class="form-group">
          <label for="mediaFiles">Resim / Medya / Belge</label>
          <input type="file" id="mediaFiles" multiple accept="image/*,video/*,audio/*,.pdf,.doc,.docx,.xls,.xlsx,.txt" />
          <small class="upload-help">Dosyalar `public/files` içine kaydedilir. Maksimum 10MB/dosya.</small>
          <div id="mediaList" class="media-list"></div>
        </div>

        <div class="form-actions">
          <button type="button" id="deleteFromFormBtn" class="btn-delete" style="display: none;">🗑️ Sil</button>
          <div class="form-actions-right">
            <button type="button" id="cancelBtn" class="btn-cancel">İptal</button>
            <button type="submit" class="btn-submit">Kaydet</button>
          </div>
        </div>
      </form>

      <div id="formMessage" class="form-message" style="display: none;"></div>
    </div>
  </div>

  <!-- Modal - Detay Görüntüleme -->
  <div id="viewModal" class="modal-overlay" style="display: none;">
    <div class="modal-content view-modal">
      <div class="modal-header">
        <h3 id="viewTitle">Not Detayı</h3>
        <button id="closeViewModal" class="btn-close">✕</button>
      </div>
      <div class="view-body">
        <div class="view-meta">
          <span id="viewKategori" class="kategori-badge"></span>
          <span id="viewTarih" class="view-date"></span>
        </div>
        <div id="viewMedia" class="view-media"></div>
        <div id="viewContent" class="view-content"></div>
        <div id="viewAttachments" class="view-attachments" style="display: none;"></div>
      </div>
      <div class="view-actions" id="viewActions" style="display: none;">
        <button type="button" id="deleteNoteBtn" class="btn-delete">🗑️ Sil</button>
        <button type="button" id="editNoteBtn" class="btn-edit-note">✏️ Düzenle</button>
      </div>
    </div>
  </div>
</PageLayout>

<style>
  .notlar-page {
    max-width: 100%;
  }

  /* Header */
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .header-content {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .header-icon {
    font-size: 2.5rem;
  }

  .header-text h1 {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0;
  }

  .header-text p {
    color: #666;
    margin: 0.25rem 0 0;
    font-size: 0.9rem;
  }

  [data-theme="dark"] .header-text p {
    color: #aaa;
  }

  .btn-new {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
    color: white;
    border: none;
    border-radius: 10px;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-new:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(245, 158, 11, 0.4);
  }

  .btn-new svg {
    width: 18px;
    height: 18px;
  }

  /* Toolbar */
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.5rem;
    align-items: stretch;
    width: 100%;
  }

  .station-filter {
    min-width: 210px;
    border: 2px solid #e0e0e0;
    border-radius: 10px;
    padding: 0.75rem;
    background: #fff;
    color: #333;
  }

  [data-theme="dark"] .station-filter {
    background: #1a1a1a;
    border-color: #333;
    color: #ddd;
  }

  .search-wrapper {
    position: relative;
    flex: 1;
    min-width: 0;
    max-width: 100%;
  }

  .search-icon {
    position: absolute;
    left: 0.9rem;
    top: 50%;
    transform: translateY(-50%);
    width: 18px;
    height: 18px;
    color: #888;
    pointer-events: none;
    z-index: 1;
  }

  .search-input {
    width: 100%;
    padding: 0.75rem 2.6rem 0.75rem 3rem;
    border: 2px solid #e0e0e0;
    border-radius: 10px;
    background: #fff;
    color: #333;
    font-size: 0.95rem;
    transition: all 0.2s ease;
    box-sizing: border-box;
  }

  [data-theme="dark"] .search-input {
    background: #1a1a1a;
    border-color: #333;
    color: #fff;
  }

  .search-input:focus {
    outline: none;
    border-color: #f59e0b;
    box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.15);
  }

  .search-clear {
    position: absolute;
    right: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #e0e0e0;
    border-radius: 50%;
    z-index: 2;
    cursor: pointer;
    font-size: 0.7rem;
    color: #666;
  }

  .search-clear:hover {
    background: #f59e0b;
    color: white;
  }

  .filter-chips {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .chip {
    padding: 0.5rem 0.875rem;
    border: 2px solid #e0e0e0;
    border-radius: 20px;
    background: #fff;
    color: #555;
    font-size: 0.8rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  [data-theme="dark"] .chip {
    background: #1a1a1a;
    border-color: #333;
    color: #ccc;
  }

  .chip:hover {
    border-color: #f59e0b;
    color: #f59e0b;
  }

  .chip.active {
    background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
    border-color: transparent;
    color: white;
  }

   :global(.pagination-container) {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1rem;
    flex-wrap: wrap;
  }
   :global(.page-btn) {
    min-width: 40px;
    height: 40px;
    padding: 0 0.7rem;
    border: 1px solid #fcd34d;
    border-radius: 12px;
    background: linear-gradient(180deg, #ffffff 0%, #fffbeb 100%);
    color: #92400e;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 6px 16px rgba(245, 158, 11, 0.14);
    transition: all 0.2s ease;
  }
   :global(.page-btn:hover) { transform: translateY(-1px); box-shadow: 0 10px 18px rgba(245, 158, 11, 0.22); }
   :global(.page-btn.active) { background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color: #fff; border-color: transparent; box-shadow: 0 10px 22px rgba(245, 158, 11, 0.35); }
  [data-theme="dark"]  :global(.page-btn) { border-color: #78350f; background: linear-gradient(180deg, #2a1b08 0%, #3a240a 100%); color: #fcd34d; box-shadow: 0 6px 16px rgba(0, 0, 0, 0.35); }
  [data-theme="dark"]  :global(.page-btn.active) { background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color: #fff; }

  /* Stats Bar */
  .stats-bar {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .stat-item {
    background: #fff;
    border: 1px solid #e0e0e0;
    border-radius: 12px;
    padding: 0.75rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    transition: all 0.2s ease;
  }

  [data-theme="dark"] .stat-item {
    background: #1a1a1a;
    border-color: #333;
  }

  .stat-value {
    font-size: 1.5rem;
    font-weight: 800;
    color: #f59e0b;
  }

  .stat-label {
    color: #888;
    font-size: 0.8rem;
    font-weight: 500;
  }

  /* Table Container */
  .table-container {
    background: #fff;
    border: 1px solid #e0e0e0;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  }

  [data-theme="dark"] .table-container {
    background: #1a1a1a;
    border-color: #333;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .data-table thead {
    background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
    color: white;
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .data-table th {
    padding: 1rem;
    text-align: left;
    font-weight: 600;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .data-table tbody tr {
    border-bottom: 1px solid #e0e0e0;
    transition: all 0.2s ease;
  }

  [data-theme="dark"] .data-table tbody tr {
    border-color: #333;
  }

  .data-table tbody tr:nth-child(even) {
    background: #f8f9fa;
  }

  [data-theme="dark"] .data-table tbody tr:nth-child(even) {
    background: #0d0d0d;
  }

  .data-table tbody tr:hover {
    background: #fffbeb;
  }

  [data-theme="dark"] .data-table tbody tr:hover {
    background: #292211;
  }

  .data-table td {
    padding: 0.875rem 1rem;
    vertical-align: middle;
  }
  [data-theme="dark"] .data-table td { color: #e0e0e0; }

  .baslik-cell {
    font-weight: 600;
  }
  [data-theme="dark"] .baslik-cell { color: #e0e0e0; }

  .kategori-badge {
    display: inline-block;
    padding: 0.3rem 0.7rem;
    border-radius: 15px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .kategori-prosedur { background: #dbeafe; color: #1e40af; }
  .kategori-sifre { background: #fee2e2; color: #b91c1c; }
  .kategori-adres { background: #d1fae5; color: #065f46; }
  .kategori-vardiya { background: #fef3c7; color: #92400e; }
  .kategori-genel { background: #e5e7eb; color: #374151; }
  .kategori-ozel { background: #ede9fe; color: #5b21b6; }

  [data-theme="dark"] .kategori-prosedur { background: #1e3a5f; color: #93c5fd; }
  [data-theme="dark"] .kategori-sifre { background: #450a0a; color: #fca5a5; }
  [data-theme="dark"] .kategori-adres { background: #064e3b; color: #6ee7b7; }
  [data-theme="dark"] .kategori-vardiya { background: #451a03; color: #fcd34d; }
  [data-theme="dark"] .kategori-genel { background: #374151; color: #d1d5db; }
  [data-theme="dark"] .kategori-ozel { background: #312e81; color: #ddd6fe; }

  .preview-cell {
    max-width: 400px;
    color: #666;
    font-size: 0.85rem;
    line-height: 1.4;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  [data-theme="dark"] .preview-cell {
    color: #aaa;
  }

  .date-cell {
    color: #666;
    font-size: 0.85rem;
    white-space: nowrap;
  }

  [data-theme="dark"] .date-cell {
    color: #aaa;
  }

  .btn-view {
    padding: 0.4rem 0.8rem;
    background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
    color: white;
    border: none;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-view:hover {
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(245, 158, 11, 0.4);
  }

  /* Light mode visibility fixes (Notlar page specific) */
  :global(html:not([data-theme="dark"])) .notlar-page .table-container .btn-view {
    background: #ffffff !important;
    color: #111827 !important;
    border: 2px solid #111827 !important;
    box-shadow: 0 1px 4px rgba(15, 23, 42, 0.18) !important;
    font-weight: 700 !important;
  }

  :global(html:not([data-theme="dark"])) .notlar-page .table-container .btn-view:hover {
    background: #f8fafc !important;
    color: #000000 !important;
    border-color: #000000 !important;
  }

  /* Loading State */
  .loading-row td {
    padding: 3rem 1rem;
  }

  .loading-state {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    color: #888;
  }

  .loading-spinner {
    width: 24px;
    height: 24px;
    border: 3px solid #e0e0e0;
    border-top-color: #f59e0b;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* No Results */
  .no-results {
    text-align: center;
    padding: 3rem 2rem;
  }
  [data-theme="dark"] .no-results { color: #ccc; }

  .no-results-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .no-results h3 {
    margin: 0 0 0.5rem;
  }
  [data-theme="dark"] .no-results h3 { color: #e0e0e0; }

  .no-results p {
    color: #888;
    margin: 0;
  }
  [data-theme="dark"] .no-results p { color: #aaa; }

  /* Modal */
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.55);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 12000;
    padding: 1rem;
  }

  .modal-content {
    background: #fff;
    border-radius: 16px;
    width: 100%;
    max-width: 600px;
    max-height: 90vh;
    overflow-y: auto;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.3);
    overflow-x: hidden;
    box-sizing: border-box;
  }

  [data-theme="dark"] .modal-content {
    background: #1a1a1a;
  }

  :global(html:not([data-theme="dark"])) #viewModal .modal-content,
  :global(html:not([data-theme="dark"])) #noteModal .modal-content {
    background: #ffffff !important;
    border: 1px solid #e2e8f0 !important;
    box-shadow: 0 20px 50px rgba(15, 23, 42, 0.2) !important;
    color: #1f2937 !important;
  }

  :global(html:not([data-theme="dark"])) #viewModal .view-modal {
    background: #ffffff !important;
  }

  :global(html:not([data-theme="dark"])) #viewModal .modal-header,
  :global(html:not([data-theme="dark"])) #noteModal .modal-header {
    border-bottom: 1px solid #e2e8f0 !important;
  }

