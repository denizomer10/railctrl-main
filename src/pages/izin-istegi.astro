---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="İzin İsteği">
  <div class="izin-page">
    <!-- Header -->
    <div class="page-header">
      <div class="header-content">
        <div class="header-icon">📅</div>
        <div class="header-text">
          <h1>İzin İsteği</h1>
          <p>8005 modeline uygun izin formu oluşturun</p>
        </div>
      </div>
    </div>

    <!-- Ana İçerik -->
    <div class="main-content">
      <!-- Personel Bilgileri ve İzin Oluştur -->
      <div id="createSection" class="create-section">
        <!-- Kayıtlı Personel Bilgisi Gösterimi -->
        <div id="personelInfo" class="personel-info" style="display: none;">
          <div class="info-card">
            <div class="info-header">
              <span class="info-icon">👤</span>
              <span class="info-title">Kullanıcı Bilgileriniz</span>
            </div>
            <div class="info-content">
              <div class="info-row">
                <span class="info-label">Ad Soyad:</span>
                <span id="infoAdSoyad" class="info-value"></span>
              </div>
              <div class="info-row">
                <span class="info-label">Birim:</span>
                <span id="infoBirim" class="info-value"></span>
              </div>
              <div class="info-row">
                <span class="info-label">Görevi:</span>
                <span id="infoGorevi" class="info-value"></span>
              </div>
            </div>
          </div>
        </div>

        <button id="createNewBtn" class="create-btn">
          <span class="btn-icon">➕</span>
          <span class="btn-text">İzin İsteği Oluştur</span>
        </button>
        <p class="create-hint">Yeni bir izin formu oluşturmak için tıklayın</p>
      </div>
    </div>

    <!-- Modal: İzin Türü Seçimi -->
    <div id="typeModal" class="modal" style="display: none;">
      <div class="modal-content modal-small">
        <div class="modal-header">
          <h3>İzin Türü Seçin</h3>
          <button class="modal-close" data-close="typeModal">&times;</button>
        </div>
        <div class="modal-body">
          <div class="type-options">
            <button class="type-btn" data-type="yillik">
              <span class="type-icon">🏖️</span>
              <span class="type-label">Yıllık İzin</span>
            </button>
            <button class="type-btn" data-type="mazeret">
              <span class="type-icon">📋</span>
              <span class="type-label">Mazeret İzni</span>
            </button>
            <button class="type-btn" data-type="hastalik">
              <span class="type-icon">🏥</span>
              <span class="type-label">Hastalık İzni</span>
            </button>
            <button class="type-btn" data-type="ucretsiz">
              <span class="type-icon">💼</span>
              <span class="type-label">Ücretsiz İzin</span>
            </button>
          </div>

        </div>
        <div class="modal-footer">
          <button id="continueTypeBtn" class="btn-primary" disabled>Devam Et</button>
        </div>
      </div>
    </div>

    <!-- Modal: Personel Kayıt Formu -->
    <div id="personelModal" class="modal" style="display: none;">
      <div class="modal-content">
        <div class="modal-header">
          <h3>👤 Personel Bilgileri</h3>
          <button class="modal-close" data-close="personelModal">&times;</button>
        </div>
        <div class="modal-body">
          <form id="personelForm">
            <div class="form-row">
              <div class="form-group">
                <label for="adSoyad">Ad Soyad *</label>
                <input type="text" id="adSoyad" name="ad_soyad" required placeholder="Adınız Soyadınız">
              </div>
              <div class="form-group">
                <label for="birim">Birim *</label>
                <input type="text" id="birim" name="birim" required placeholder="Çalıştığınız birim">
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label for="gorevi">Görevi *</label>
                <input type="text" id="gorevi" name="gorevi" required placeholder="Göreviniz (örn: İstasyon Operasyon İşçisi)">
              </div>
              <div class="form-group">
                <label for="izindekiAdresKayit">İzindeki Adres</label>
                <input type="text" id="izindekiAdresKayit" name="izindeki_adres" placeholder="İzin sırasında kalacağınız adres">
              </div>
            </div>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn-secondary" data-close="personelModal">İptal</button>
          <button type="button" id="savePersonelBtn" class="btn-primary">Kaydet ve Devam Et</button>
        </div>
      </div>
    </div>

    <!-- Modal: İzin Formu -->
    <div id="izinModal" class="modal" style="display: none;">
      <div class="modal-content modal-large">
        <div class="modal-header">
          <h3>📝 İzin Formu</h3>
          <button class="modal-close" data-close="izinModal">&times;</button>
        </div>
        <div class="modal-body">
          <form id="izinForm">
            <input type="hidden" id="izinTuru" name="izin_turu">
            <input type="hidden" id="personelId" name="personel_id">
            
            <div class="form-section">
              <h4>Personel Bilgileri</h4>
              <div class="form-row">
                <div class="form-group">
                  <label>Ad Soyad</label>
                  <input type="text" id="izinAdSoyad" name="ad_soyad" readonly>
                </div>
                <div class="form-group">
                  <label>Birim</label>
                  <input type="text" id="izinBirim" name="birim" readonly>
                </div>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label>Görevi</label>
                  <input type="text" id="izinGorevi" name="gorevi" readonly>
                </div>
                <div class="form-group">
                  <label>İzindeki Adres</label>
                  <input type="text" id="izindekiAdres" name="izindeki_adres" readonly>
                </div>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label for="izinSicilNo">Sicil No</label>
                  <input type="text" id="izinSicilNo" name="sicil_no" placeholder="Sicil numaranız">
                </div>
                <div class="form-group">
                  <label>Ait Olduğu Yıl</label>
                  <input type="number" id="aitOlduguYil" name="ait_oldugu_yil" readonly>
                </div>
              </div>
            </div>

            <div class="form-section">
              <h4>İzin Bilgileri</h4>
              <div class="izin-type-display">
                <span id="izinTuruDisplay" class="type-badge"></span>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label for="baslangicTarihi">Başlangıç Tarihi *</label>
                  <input type="date" id="baslangicTarihi" name="baslangic_tarihi" required>
                </div>
                <div class="form-group">
                  <label for="bitisTarihi">Bitiş Tarihi *</label>
                  <input type="date" id="bitisTarihi" name="bitis_tarihi" required>
                </div>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label for="yolIzni">Yol İzni (Gün)</label>
                  <input type="number" id="yolIzni" name="yol_izni" min="0" value="0">
                </div>
                <div class="form-group">
                  <label for="izinGunSayisi">Kullanılacak İzin Toplamı (Gün) *</label>
                  <input type="number" id="izinGunSayisi" name="izin_gun_sayisi" min="1" required>
                </div>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label for="kalanIzin">Kalan İzin (Gün)</label>
                  <input type="number" id="kalanIzin" name="kalan_izin" min="0">
                </div>
                <div class="form-group">
                  <label for="isBasiTarihi">İş Başı Tarihi</label>
                  <input type="date" id="isBasiTarihi" name="is_basi_tarihi">
                </div>
              </div>
              <div class="form-row">
                <div class="form-group full-width">
                  <label for="aciklama">Açıklama</label>
                  <textarea id="aciklama" name="aciklama" rows="2" placeholder="Varsa açıklama yazınız"></textarea>
                </div>
              </div>
              <div class="form-row">
                <div class="form-group full-width">
                  <label for="izindekiAdres">İzindeki Adres</label>
                  <input type="text" id="izindekiAdres" name="izindeki_adres" placeholder="İzin süresince kalacağınız adres">
                </div>
              </div>
            </div>

            <div class="form-section">
              <h4>İstemde Bulunanın</h4>
              <div class="form-row">
                <div class="form-group">
                  <label>Tarih</label>
                  <input type="text" id="istemTarihi" readonly>
                </div>
                <div class="form-group">
                  <label>İmza</label>
                  <div class="signature-placeholder">
                    <span id="signatureName"></span>
                  </div>
                </div>
              </div>
            </div>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn-secondary" data-close="izinModal">İptal</button>
          <button type="button" id="previewPdfBtn" class="btn-primary">PDF Önizle</button>
        </div>
      </div>
    </div>

    <!-- Modal: PDF Önizleme -->
    <div id="pdfModal" class="modal" style="display: none;">
      <div class="modal-content modal-pdf">
        <div class="modal-header">
          <h3>📄 İzin Formu - 8005 Modeli</h3>
          <button class="modal-close" data-close="pdfModal">&times;</button>
        </div>
        <div class="modal-body pdf-body">
          <div id="pdfPreview" class="pdf-preview"></div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn-secondary" data-close="pdfModal">Kapat</button>
          <button type="button" id="downloadPdfBtn" class="btn-success">
            <span>📥</span> İndir
          </button>
          <button type="button" id="printPdfBtn" class="btn-primary">
            <span>🖨️</span> Yazdır
          </button>
        </div>
      </div>
    </div>
  </div>
</PageLayout>

<style>
  .izin-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px;
  }

  .page-header {
    text-align: center;
    margin-bottom: 40px;
  }

  .header-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .header-icon {
    font-size: 3rem;
  }

  .header-text h1 {
    margin: 0;
    font-size: 2rem;
    color: #333;
  }

  [data-theme="dark"] .header-text h1 {
    color: #fff;
  }

  .header-text p {
    margin: 5px 0 0;
    color: #666;
  }

  [data-theme="dark"] .header-text p {
    color: #aaa;
  }

  /* Create Section */
  .create-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 300px;
    padding: 40px;
  }

  /* Personel Bilgi Kartı */
  .personel-info {
    width: 100%;
    max-width: 500px;
    margin-bottom: 30px;
  }

  .info-card {
    background: #fff;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
    overflow: hidden;
  }

  [data-theme="dark"] .info-card {
    background: #1a1a2e;
  }

  .info-header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 15px 20px;
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: #fff;
  }

  .info-icon {
    font-size: 1.3rem;
  }

  .info-title {
    flex: 1;
    font-weight: 600;
    font-size: 1rem;
  }

  .edit-btn, .delete-btn {
    background: rgba(255, 255, 255, 0.2);
    border: none;
    border-radius: 8px;
    padding: 8px 12px;
    cursor: pointer;
    font-size: 1rem;
    transition: background 0.2s;
  }

  .edit-btn:hover {
    background: rgba(255, 255, 255, 0.3);
  }

  .delete-btn:hover {
    background: rgba(255, 100, 100, 0.4);
  }

  .info-content {
    padding: 15px 20px;
  }

  .info-row {
    display: flex;
    padding: 8px 0;
    border-bottom: 1px solid #eee;
  }

  [data-theme="dark"] .info-row {
    border-bottom-color: #333;
  }

  .info-row:last-child {
    border-bottom: none;
  }

  .info-label {
    width: 100px;
    font-weight: 600;
    color: #666;
    font-size: 0.85rem;
  }

  [data-theme="dark"] .info-label {
    color: #aaa;
  }

  .info-value {
    flex: 1;
    color: #333;
    font-size: 0.9rem;
  }

  [data-theme="dark"] .info-value {
    color: #fff;
  }

  .create-btn {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 25px 50px;
    font-size: 1.3rem;
    font-weight: 600;
    color: #fff;
    background: linear-gradient(135deg, #667eea, #764ba2);
    border: none;
    border-radius: 20px;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 10px 30px rgba(102, 126, 234, 0.4);
  }

  .create-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 40px rgba(102, 126, 234, 0.5);
  }

  .btn-icon {
    font-size: 1.5rem;
  }

  .create-hint {
    margin-top: 20px;
    color: #888;
    font-size: 0.9rem;
  }

  /* Modal Styles */
  .modal {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(15, 23, 42, 0.55);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 12000;
    padding: 20px;
    overflow-y: auto;
    overscroll-behavior: contain;
    touch-action: pan-y;
  }

  .modal-content {
    background: #fff;
    border-radius: 20px;
    width: 100%;
    max-width: 600px;
    max-height: 90vh;
    overflow-y: auto;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    position: relative;
    pointer-events: auto;
  }

  [data-theme="dark"] .modal-content {
    background: #1a1a2e;
    color: #fff;
  }

  .modal-small {
    max-width: 450px;
  }

  .modal-large {
    max-width: 700px;
  }

  .modal-pdf {
    max-width: 900px;
    height: 90vh;
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 25px;
    border-bottom: 1px solid #e5e7eb;
  }

  [data-theme="dark"] .modal-header {
    border-bottom-color: #333;
  }

  .modal-header h3 {
    margin: 0;
    font-size: 1.25rem;
  }

  .modal-close {
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
    color: #666;
    padding: 0;
    line-height: 1;
  }

  [data-theme="dark"] .modal-close {
    color: #aaa;
  }

  .modal-body {
    padding: 25px;
  }

  .modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    padding: 20px 25px;
    border-top: 1px solid #e5e7eb;
  }

  [data-theme="dark"] .modal-footer {
    border-top-color: #333;
  }

  /* Type Options */
  .type-options {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
    margin-bottom: 20px;
  }

  .type-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 20px;
    background: #f8f9fa;
    border: 2px solid transparent;
    border-radius: 15px;
    cursor: pointer;
    transition: all 0.2s ease;
    min-height: 110px;
    color: #1f2937;
  }

  [data-theme="dark"] .type-btn {
    background: #111827;
    border-color: #334155;
    color: #f8fafc;
  }

  .type-btn:hover {
    border-color: #667eea;
    background: rgba(102, 126, 234, 0.1);
  }

  [data-theme="dark"] .type-btn:hover {
    border-color: #60a5fa;
    background: #1e293b;
    color: #f8fafc;
  }

  [data-theme="dark"] .type-btn:hover .type-label {
    color: #f8fafc !important;
    opacity: 1 !important;
  }

  .type-btn.selected {
    border-color: #667eea;
    background: rgba(102, 126, 234, 0.15);
    color: #1f2937;
  }

  [data-theme="dark"] .type-btn.selected {
    background: #1e3a8a;
    border-color: #60a5fa;
    color: #f8fafc;
  }

  .type-icon {
    font-size: 2rem;
  }

  .type-label {
    font-weight: 600;
    font-size: 0.9rem;
    color: #333;
  }

  [data-theme="dark"] .type-label {
    color: #fff;
  }

  /* Record Check */
  .record-check {
    padding-top: 15px;
    border-top: 1px solid #e5e7eb;
  }

  [data-theme="dark"] .record-check {
    border-top-color: #333;
  }

  .checkbox-label {
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    font-size: 0.95rem;
  }

  .checkbox-label input {
    width: 18px;
    height: 18px;
  }

  /* Form Styles */
  .form-section {
    margin-bottom: 25px;
    padding-bottom: 20px;
    border-bottom: 1px solid #e5e7eb;
  }

  [data-theme="dark"] .form-section {
    border-bottom-color: #333;
  }

  .form-section:last-child {
    border-bottom: none;
    margin-bottom: 0;
  }

  .form-section h4 {
    margin: 0 0 15px;
    color: #667eea;
    font-size: 1rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
    margin-bottom: 15px;
  }

  @media (max-width: 600px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .form-group.full-width {
    grid-column: 1 / -1;
  }

  .form-group label {
    font-size: 0.85rem;
    font-weight: 600;
    color: #555;
  }

  [data-theme="dark"] .form-group label {
    color: #aaa;
  }

  .form-group input,
  .form-group textarea {
    padding: 12px 15px;
    border: 1px solid #ddd;
    border-radius: 10px;
    font-size: 0.95rem;
    transition: border-color 0.2s;
    font-family: inherit;
  }

  .form-group textarea {
    resize: vertical;
  }

  [data-theme="dark"] .form-group input,
  [data-theme="dark"] .form-group textarea {
    background: #252545;
    border-color: #444;
    color: #fff;
  }

  [data-theme="dark"] .form-group input[type="date"]::-webkit-calendar-picker-indicator {
    filter: invert(1) brightness(1.2);
    opacity: 0.9;
    cursor: pointer;
  }

  :global(html[data-theme="dark"] #izinModal input[type="date"]::-webkit-calendar-picker-indicator) {
    filter: invert(1) brightness(1.2);
    opacity: 0.9;
  }

  .form-group input:focus {
    outline: none;
    border-color: #667eea;
  }

  .form-group input[readonly] {
    background: #f5f5f5;
    cursor: not-allowed;
  }

  [data-theme="dark"] .form-group input[readonly] {
    background: #1a1a2e;
  }

  /* İzin Type Display */
  .izin-type-display {
    margin-bottom: 15px;
  }

  .type-badge {
    display: inline-block;
    padding: 8px 20px;
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: #fff;
    border-radius: 25px;
    font-weight: 600;
    font-size: 0.9rem;
  }

  /* Signature Placeholder */
  .signature-placeholder {
    padding: 15px;
    background: #f8f9fa;
    border: 1px dashed #ddd;
    border-radius: 10px;
    text-align: center;
    font-style: italic;
    color: #666;
  }

  [data-theme="dark"] .signature-placeholder {
    background: #252545;
    border-color: #444;
    color: #aaa;
  }

  /* Modallar body altina tasindigi icin dark mode'da dogrudan modal id ile de zorla */
  :global(html[data-theme="dark"] #izinModal .signature-placeholder) {
    background: #111827 !important;
    border-color: #334155 !important;
    color: #e2e8f0 !important;
  }

  :global(html[data-theme="dark"] #izinModal #signatureName) {
    color: #f8fafc !important;
    opacity: 1 !important;
    font-style: normal;
    font-weight: 600;
  }

  /* Buttons */
  .btn-primary, .btn-secondary, .btn-success {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 25px;
    font-size: 0.95rem;
    font-weight: 600;
    border: none;
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.2s ease;
    min-height: 44px;
    touch-action: manipulation;
  }

  body.modal-open {
    overflow: hidden;
    height: 100dvh;
  }

  .btn-primary {
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: #fff;
  }

  .btn-primary:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 5px 20px rgba(102, 126, 234, 0.4);
  }

  .btn-primary:disabled {
    opacity: 1;
    cursor: not-allowed;
    background: #4b5563;
    color: #d1d5db;
  }

  .btn-secondary {
    background: #e5e7eb;
    color: #333;
  }

  [data-theme="dark"] .btn-secondary {
    background: #333;
    color: #fff;
  }

  .btn-success {
    background: linear-gradient(135deg, #10b981, #059669);
    color: #fff;
  }

  /* PDF Preview */
  .pdf-body {
    padding: 0;
    height: calc(90vh - 140px);
    overflow: auto;
  }

  .pdf-preview {
    background: #fff;
    padding: 40px;
