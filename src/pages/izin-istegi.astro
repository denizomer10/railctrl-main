  :global(html[data-theme="dark"]) .izin-page .header-text h1 {
    color: #f8fafc !important;
  }

  :global(html[data-theme="dark"]) .izin-page .header-text p,
  :global(html[data-theme="dark"]) .izin-page .create-hint {
