---
// @ts-nocheck
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
const { title } = Astro.props;
const user = Astro.locals.user;
const assetVersion = import.meta.env.PUBLIC_ASSET_VERSION || __RAILCTRL_BUILD_ID__;
---

<!doctype html>
<html lang="tr" data-asset-version={assetVersion}>
  <head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} - Tren Yönetim Sistemi</title>
  
  <!-- Favicon -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="apple-touch-icon-precomposed" href="/apple-touch-icon-precomposed.png" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <meta name="msapplication-TileImage" content="/icons/icon-192.png" />
  <meta name="msapplication-TileColor" content="#1b2845" />
  
  <!-- PWA -->
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#1b2845" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Tren Yönetim Sistemi" />
  <script is:inline>
    try {
      var __t = localStorage.getItem('theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', __t);
      var __savedLanguage = localStorage.getItem('lang');
      var __systemLanguage = navigator.languages?.[0] || navigator.language || 'en';
      document.documentElement.lang = __savedLanguage === 'tr' || __savedLanguage === 'en'
        ? __savedLanguage
        : (__systemLanguage.toLowerCase().startsWith('tr') ? 'tr' : 'en');
    } catch (e) {}
  </script>
  <script>
    import { initShell } from '../scripts/app-shell';
    initShell({ assetVersion: document.documentElement.dataset.assetVersion });
  </script>
  <link rel="stylesheet" href={`/css/app.css?v=${assetVersion}`} />
  <style>
    :root {
      --primary-color: #007acc;
      --secondary-color: #005a99;
      --background-overlay: rgba(255, 255, 255, 0.22);
      --card-bg: rgba(255, 255, 255, 0.58);
      --text-color: #333;
      --transition-speed: 0.3s;
      --header-bg: rgba(14, 62, 115, 0.42);
      --footer-bg: rgba(14, 62, 115, 0.38);
      --shadow-color: rgba(0,0,0,0.1);
      --border-color: rgba(255,255,255,0.34);
    }

    /* Dark mode variables */
    [data-theme="dark"] {
      --primary-color: #4da6ff;
      --secondary-color: #3385dd;
      --background-overlay: rgba(15, 23, 42, 0.42);
      --card-bg: rgba(15, 23, 42, 0.56);
      --text-color: #ffffff;
      --header-bg: rgba(15, 23, 42, 0.58);
      --footer-bg: rgba(15, 23, 42, 0.55);
      --shadow-color: rgba(0,0,0,0.6);
      --border-color: rgba(148,163,184,0.22);
    }

    /* Make page background dark with overlay in dark mode */
    html[data-theme="dark"] body {
      color: var(--text-color);
      background:
        radial-gradient(48% 36% at 12% 8%, rgba(30, 64, 175, 0.26), transparent 72%),
        radial-gradient(40% 34% at 88% 12%, rgba(6, 95, 70, 0.22), transparent 74%),
        radial-gradient(46% 40% at 80% 88%, rgba(124, 58, 237, 0.16), transparent 78%),
        linear-gradient(145deg, #0b1220 0%, #111827 55%, #0f172a 100%);
    }

    * {
      box-sizing: border-box;
    }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      margin: 0;
      padding: 0;
      background: linear-gradient(145deg, rgba(239,246,255,0.78), rgba(236,253,245,0.64));
      color: var(--text-color);
      min-height: 100vh;
      overflow-x: hidden;
      /* animation: fadeIn 0.5s ease-in; */
    }

    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    header {
      background: var(--header-bg);
      backdrop-filter: blur(16px) saturate(150%);
      -webkit-backdrop-filter: blur(16px) saturate(150%);
      color: white;
      padding: 1rem 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      box-shadow: 0 2px 10px var(--shadow-color);
      position: sticky;
      top: 0;
      z-index: 100;
      transition: all var(--transition-speed);
    }

    .header-left {
      display: flex;
      align-items: center;
    }

    .logo {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      height: 60px;
      min-width: 60px;
      margin-right: 1rem;
      font-size: 2.5rem;
      line-height: 1;
      text-decoration: none;
      transition: transform var(--transition-speed);
    }

    .logo:hover {
      transform: scale(1.05);
    }

    .header-feedback-btn {
      width: 38px;
      height: 38px;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.32);
      background: rgba(255, 255, 255, 0.14);
      color: #fff;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      margin-left: 0.35rem;
      transition: transform 0.2s ease, background 0.2s ease;
    }

    .header-feedback-btn:hover {
      transform: translateY(-1px);
      background: rgba(255, 255, 255, 0.24);
    }

    main {
      max-width: 1200px;
      margin: 2rem auto;
      padding: 2rem;
      background: var(--card-bg);
      border-radius: 15px;
      box-shadow: 0 8px 32px var(--shadow-color);
      backdrop-filter: blur(10px);
      /* animation: slideUp 0.3s ease-out 0.2s both; */
      min-height: 60vh;
    }

    @keyframes slideUp {
      from { transform: translateY(50px); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }

    footer {
      text-align: center;
      padding: 1rem;
      background: var(--footer-bg);
      color: white;
      backdrop-filter: blur(14px) saturate(145%);
      -webkit-backdrop-filter: blur(14px) saturate(145%);
      margin-top: 2rem;
      /* animation: fadeInUp 0.6s ease-out 0.6s both; */
    }

    @keyframes fadeInUp {
      from { transform: translateY(20px); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }

    .social-links {
      display: flex;
      justify-content: center;
      gap: 0.75rem;
      margin-top: 1rem;
      align-items: center;
    }

    .social-links a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 48px;
      height: 48px;
      border-radius: 12px;
      background: rgba(255,255,255,0.06);
      transition: transform var(--transition-speed), box-shadow var(--transition-speed), background var(--transition-speed);
      text-decoration: none;
      border: 1px solid rgba(255,255,255,0.06);
      box-shadow: 0 2px 6px rgba(0,0,0,0.12);
    }

    .social-links a svg {
      width: 22px;
      height: 22px;
      display: block;
      fill: currentColor;
    }

    /* Brand colors (using CSS variables inline on anchors) */
    .social-links a.youtube { color: #FF0000; }
    .social-links a.instagram { color: #E1306C; }
    .social-links a.teknofest { color: #FF7A00; }

    .social-links a:hover {
      transform: translateY(-4px) scale(1.05);
      box-shadow: 0 8px 20px var(--shadow-color);
      background: var(--border-color);
    }

    .spotlight-fab {
      position: fixed;
      left: 1rem;
      bottom: 1rem;
      z-index: 2200;
      min-height: 46px;
      padding: 0.6rem 0.85rem;
      border-radius: 999px;
      border: 1px solid rgba(59, 130, 246, 0.35);
      background: linear-gradient(135deg, #eff6ff, #dbeafe);
      color: #1d4ed8;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-weight: 700;
      font-size: 0.85rem;
      cursor: pointer;
      box-shadow: 0 14px 28px rgba(15, 23, 42, 0.22);
    }

    .spotlight-fab-icon {
      width: 24px;
      height: 24px;
      border-radius: 999px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: rgba(59, 130, 246, 0.12);
      font-size: 0.76rem;
      font-weight: 800;
    }

    [data-theme="dark"] .spotlight-fab {
      background: linear-gradient(135deg, rgba(30, 64, 175, 0.45), rgba(59, 130, 246, 0.25));
      border-color: rgba(96, 165, 250, 0.45);
      color: #bfdbfe;
      box-shadow: 0 16px 32px rgba(2, 6, 23, 0.45);
    }

    [data-theme="dark"] .notify-bell {
      background: rgba(15, 23, 42, 0.6);
      border-color: rgba(148, 163, 184, 0.28);
      color: #eaf3ff;
      box-shadow: 0 16px 32px rgba(2, 6, 23, 0.46);
    }

    .notify-bell {
      position: fixed;
      right: 1rem;
      bottom: 1rem;
      z-index: 2300;
      min-width: 46px;
      min-height: 46px;
      border-radius: 999px;
      border: 1px solid rgba(148, 163, 184, 0.35);
      background: rgba(255, 255, 255, 0.58);
      color: #0f172a;
      -webkit-backdrop-filter: blur(14px) saturate(155%);
      backdrop-filter: blur(14px) saturate(155%);
      font-size: 1.1rem;
      cursor: pointer;
      box-shadow: 0 14px 28px rgba(15, 23, 42, 0.2);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .notify-bell.bump {
      animation: notifyBellBump 0.5s ease;
    }

    @keyframes notifyBellBump {
      0% { transform: scale(1) rotate(0deg); }
      30% { transform: scale(1.14) rotate(-12deg); }
      60% { transform: scale(1.06) rotate(10deg); }
      100% { transform: scale(1) rotate(0deg); }
    }

    .notify-badge {
      position: absolute;
      top: -6px;
      right: -6px;
      background: linear-gradient(135deg, #ef4444, #dc2626);
      color: #fff;
      border: 1px solid rgba(255, 255, 255, 0.72);
      border-radius: 999px;
      padding: 3px 6px;
      line-height: 1;
      font-size: 0.72rem;
      min-width: 20px;
    }

    .notify-badge.pulse {
      animation: notifyBadgePulse 0.5s ease;
    }

    @keyframes notifyBadgePulse {
      0% { transform: scale(1); }
      40% { transform: scale(1.35); }
      100% { transform: scale(1); }
    }

    .notify-panel {
      position: fixed;
      right: 1rem;
      bottom: 4.4rem;
      width: min(380px, calc(100vw - 2rem));
      max-height: 60vh;
      background: rgba(255, 255, 255, 0.62);
      border: 1px solid rgba(148, 163, 184, 0.34);
      border-radius: 16px;
      box-shadow: 0 24px 56px rgba(2, 6, 23, 0.22);
      -webkit-backdrop-filter: blur(16px) saturate(155%);
      backdrop-filter: blur(16px) saturate(155%);
      z-index: 2400;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .notify-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 0.5rem;
      padding: 0.65rem 0.8rem;
      border-bottom: 1px solid #e5e7eb;
      font-size: 0.85rem;
    }

    .notify-head button {
      border: none;
      background: transparent;
      color: #2563eb;
      font-weight: 700;
      cursor: pointer;
    }

    .notify-list {
      overflow: auto;
      padding: 0.55rem;
      display: grid;
      gap: 0.45rem;
    }

    .notify-item {
      border: 1px solid #e5e7eb;
      border-radius: 10px;
      padding: 0.55rem 0.65rem;
      background: #f8fafc;
      font-size: 0.82rem;
    }

    .notify-item.unread {
      border-color: #93c5fd;
      background: #eff6ff;
    }

    .notify-toast {
      position: fixed;
      right: 1rem;
      bottom: 4.7rem;
      width: min(360px, calc(100vw - 2rem));
      z-index: 2450;
      background: rgba(15, 23, 42, 0.92);
      color: #f8fafc;
      border: 1px solid rgba(96, 165, 250, 0.4);
      border-radius: 12px;
      padding: 0.75rem 0.85rem;
      box-shadow: 0 20px 40px rgba(2, 6, 23, 0.45);
      opacity: 0;
      transform: translateY(12px) scale(0.98);
      pointer-events: none;
      transition: opacity 0.22s ease, transform 0.22s ease;
    }

    .notify-toast.show {
      opacity: 1;
      transform: translateY(0) scale(1);
    }

    .notify-toast-title {
      font-size: 0.84rem;
      font-weight: 700;
      margin-bottom: 0.2rem;
    }

    .notify-toast-message {
      font-size: 0.79rem;
      opacity: 0.9;
      line-height: 1.35;
      margin-bottom: 0.3rem;
    }

    .notify-toast-meta {
      font-size: 0.72rem;
      opacity: 0.74;
    }

    .feedback-modal {
      position: fixed;
      inset: 0;
      z-index: 12050;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 1rem;
      background: rgba(2, 6, 23, 0.5);
      backdrop-filter: blur(4px);
    }
    .spotlight-modal[aria-hidden="true"],
    .feedback-modal[aria-hidden="true"] {
      display: none !important;
    }
    .spotlight-modal[aria-hidden="false"],
    .feedback-modal[aria-hidden="false"] {
      display: flex !important;
    }

    .feedback-dialog {
      width: min(460px, 100%);
      background: #fff;
      border: 1px solid #dbeafe;
      border-radius: 14px;
      box-shadow: 0 24px 56px rgba(2, 6, 23, 0.3);
      padding: 0.95rem;
      display: grid;
      gap: 0.75rem;
    }

    .feedback-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.6rem;
    }

    .feedback-head h3 {
      margin: 0;
      font-size: 1rem;
      color: #0f172a;
    }

    .feedback-close {
      width: 32px;
      height: 32px;
      border: 1px solid #d1d5db;
      border-radius: 8px;
      background: #f8fafc;
      cursor: pointer;
      font-size: 1.15rem;
      line-height: 1;
    }

    .feedback-input {
      width: 100%;
      min-height: 120px;
      resize: vertical;
      border-radius: 10px;
      border: 1px solid #cbd5e1;
      padding: 0.75rem;
      font-size: 0.9rem;
      font-family: inherit;
    }

    .feedback-input:focus {
      outline: none;
      border-color: #60a5fa;
      box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.18);
    }

    .feedback-actions {
      display: flex;
      justify-content: flex-end;
      gap: 0.55rem;
    }

    .feedback-btn {
      border: 1px solid #cbd5e1;
      border-radius: 10px;
      padding: 0.52rem 0.85rem;
      background: #fff;
      color: #0f172a;
      font-weight: 600;
      cursor: pointer;
    }

    .feedback-btn.primary {
      border-color: #2563eb;
      background: #2563eb;
      color: #fff;
    }

    .feedback-msg {
      font-size: 0.84rem;
      min-height: 1.2rem;
      color: #dc2626;
    }

    .feedback-msg.success {
      color: #059669;
    }

    [data-theme="dark"] .feedback-dialog {
      background: #0f172a;
      border-color: #334155;
    }

    [data-theme="dark"] .feedback-head h3 {
      color: #e2e8f0;
    }

    [data-theme="dark"] .feedback-close {
      background: #1f2937;
      color: #e2e8f0;
      border-color: #374151;
    }

    [data-theme="dark"] .feedback-input {
      background: #111827;
      color: #e2e8f0;
      border-color: #374151;
    }

    [data-theme="dark"] .feedback-btn {
      background: #111827;
      color: #e2e8f0;
      border-color: #334155;
    }

    [data-theme="dark"] .notify-panel {
      background: rgba(15, 23, 42, 0.62);
      border-color: rgba(148, 163, 184, 0.28);
      color: #e5e7eb;
    }

    [data-theme="dark"] .notify-item {
      background: rgba(15, 23, 42, 0.54);
      border-color: rgba(148, 163, 184, 0.22);
    }

    .spotlight-modal {
      position: fixed;
      inset: 0;
      z-index: 12000;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1rem;
      background: rgba(2, 6, 23, 0.45);
      -webkit-backdrop-filter: blur(10px);
      backdrop-filter: blur(10px);
    }

    .spotlight-panel {
      width: min(760px, 100%);
      max-height: min(76vh, 700px);
      overflow: hidden;
      border-radius: 18px;
      background: #ffffff;
      border: 1px solid #dbeafe;
      box-shadow: 0 28px 70px rgba(2, 6, 23, 0.38);
      display: flex;
      flex-direction: column;
    }

    [data-theme="dark"] .spotlight-panel {
      background: #0f172a;
      border-color: #334155;
    }

    .spotlight-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      padding: 0.85rem 1rem;
      border-bottom: 1px solid #e2e8f0;
    }

    [data-theme="dark"] .spotlight-head {
      border-bottom-color: #334155;
    }

    .spotlight-head-title {
      font-size: 0.9rem;
      font-weight: 700;
      color: #1e293b;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }

    .spotlight-shortcut {
      font-size: 0.72rem;
      font-weight: 700;
      color: #475569;
      background: #e2e8f0;
      border: 1px solid #cbd5e1;
      border-radius: 999px;
      padding: 0.14rem 0.45rem;
    }

    [data-theme="dark"] .spotlight-head-title {
      color: #e2e8f0;
    }

    [data-theme="dark"] .spotlight-shortcut {
      color: #cbd5e1;
      background: #1f2937;
      border-color: #374151;
    }

    .spotlight-close {
      width: 34px;
      height: 34px;
      border: 1px solid #d1d5db;
      border-radius: 10px;
      background: #f8fafc;
      color: #334155;
      font-size: 1.25rem;
      cursor: pointer;
    }

    [data-theme="dark"] .spotlight-close {
      background: #1f2937;
      border-color: #374151;
      color: #cbd5e1;
    }

    .spotlight-input-wrap {
      position: relative;
      padding: 0.9rem 1rem 0.6rem;
    }

    .spotlight-input-icon {
      position: absolute;
      left: 1.8rem;
      top: 1.58rem;
      color: #64748b;
      pointer-events: none;
    }

    .spotlight-input {
      width: 100%;
      min-height: 48px;
      border-radius: 12px;
      border: 1px solid #cbd5e1;
      background: #f8fafc;
      color: #0f172a;
      padding: 0.75rem 3rem 0.75rem 2.35rem;
      font-size: 0.94rem;
    }
    .spotlight-input:focus {
      outline: none;
      border-color: #60a5fa;
      box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
    }

    [data-theme="dark"] .spotlight-input {
      background: #111827;
      border-color: #374151;
      color: #e5e7eb;
    }

    [data-theme="dark"] .spotlight-input::placeholder {
      color: #94a3b8;
    }
    .spotlight-hint {
      padding: 0 1rem 0.6rem;
      color: #64748b;
      font-size: 0.82rem;
      font-weight: 600;
    }

    [data-theme="dark"] .spotlight-hint {
      color: #94a3b8;
    }
    .spotlight-results {
      overflow: auto;
      padding: 0 0.8rem 0.8rem;
      display: grid;
      gap: 0.5rem;
    }

    .spotlight-result {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      padding: 0.7rem 0.8rem;
      border: 1px solid #dbeafe;
      border-radius: 12px;
      text-decoration: none;
      background: #f8fbff;
      color: #0f172a;
      text-decoration: none !important;
      transition: transform 0.16s ease, border-color 0.16s ease, background 0.16s ease;
    }

    .spotlight-result:visited,
    .spotlight-result:hover,
    .spotlight-result:active,
    .spotlight-result:focus {
      color: #0f172a;
      text-decoration: none !important;
    }

    .spotlight-result:hover {
      transform: translateY(-1px);
      border-color: #93c5fd;
      background: #eff6ff;
    }

    [data-theme="dark"] .spotlight-result {
      background: #111827;
      border-color: #334155;
      color: #e5e7eb;
    }

    [data-theme="dark"] .spotlight-result:visited,
    [data-theme="dark"] .spotlight-result:hover,
    [data-theme="dark"] .spotlight-result:active,
    [data-theme="dark"] .spotlight-result:focus {
      color: #e5e7eb;
      text-decoration: none !important;
    }

    [data-theme="dark"] .spotlight-result:hover {
      background: #1e293b;
      border-color: #475569;
    }

    .spotlight-result-main {
      min-width: 0;
      flex: 1;
    }

    .spotlight-result-title {
      font-size: 0.9rem;
      font-weight: 700;
      margin-bottom: 0.15rem;
    }

    .spotlight-result-sub {
      font-size: 0.8rem;
      color: #64748b;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    [data-theme="dark"] .spotlight-result-sub {
      color: #94a3b8;
    }

    .spotlight-badge {
      flex-shrink: 0;
      border-radius: 999px;
      padding: 0.22rem 0.58rem;
      font-size: 0.72rem;
      font-weight: 700;
      background: #dbeafe;
      color: #1d4ed8;
    }

    [data-theme="dark"] .spotlight-badge {
      background: #1e3a8a;
      color: #bfdbfe;
    }

    .spotlight-empty {
      padding: 1rem;
      text-align: center;
      border: 1px dashed #cbd5e1;
      border-radius: 12px;
      color: #64748b;
      font-size: 0.86rem;
    }

    [data-theme="dark"] .spotlight-empty {
      border-color: #475569;
      color: #94a3b8;
    }

    /* Mobile Styles */
    @media (max-width: 768px) {
      header {
        flex-direction: row;
        padding: 1rem;
        align-items: center;
        position: relative;
      }

      .header-left {
        margin-bottom: 0;
        flex: 1;
        display: flex;
        justify-content: center;
        order: 2; /* Mobile: logo in middle */
      }

      .header-left .logo {
        height: 45px;
      }

      /* Navigation component contains mobile-header with order: 1 and 3 */

      main {
        margin: 1rem;
        padding: 1rem;
        border-radius: 10px;
      }

      /* Disable animations on mobile for better performance */
      body, header, main, footer {
        animation: none !important;
      }

      /* Disable hover effects on mobile */
      .logo:hover {
        transform: none !important;
      }

      .spotlight-fab {
        left: 0.7rem;
        bottom: 0.7rem;
        min-height: 42px;
        padding: 0.52rem 0.72rem;
      }

      .notify-bell {
        right: 0.7rem;
        bottom: 0.7rem;
      }

      .spotlight-panel {
        width: 100%;
        max-height: 88vh;
      }
    }

    /* Tablet Styles */
    @media (min-width: 769px) and (max-width: 1024px) {
      main {
        padding: 1.5rem;
        margin: 1.5rem auto;
      }
    }

    /* Respect user's motion preferences */
    @media (prefers-reduced-motion: reduce) {
      * {
        animation: none !important;
        transition: none !important;
      }
    }

  </style>
</head>
<body>
  <header>
    <div class="header-left">
      <a href="/">
        <span class="logo" role="img" aria-label="Tren Yönetim Sistemi" data-nav-attr="aria-label:appTitle">🚂</span>
      </a>
      {user && (
        <button id="feedbackIconBtn" class="header-feedback-btn" type="button" aria-label="Geri bildirim" data-nav-attr="aria-label:feedback">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
          </svg>
        </button>
      )}
    </div>
    {user && <Navigation />}
  </header>

  <main>
    <slot />
  </main>

  <Footer />
  {user && (
    <>
      <button id="notifyBell" class="notify-bell" type="button" aria-label="Bildirimler" data-nav-attr="aria-label:notifications">
        🔔
        <span id="notifyBadge" class="notify-badge" style="display:none;">0</span>
      </button>
      <div id="notifyPanel" class="notify-panel" style="display:none;">
        <div class="notify-head">
          <strong>Bildirimler</strong>
          <div style="display:flex; gap:.45rem;">
            <button id="markAllNotifications" type="button" data-i18n="markRead">Okundu yap</button>
            <button id="clearNotifications" type="button" data-i18n="clear">Temizle</button>
          </div>
        </div>
        <div id="notifyList" class="notify-list"></div>
      </div>
      <div id="notifyToast" class="notify-toast" aria-live="polite"></div>

      <button id="globalSearchFab" class="spotlight-fab" type="button" aria-label="Site içinde ara">
        <span class="spotlight-fab-icon" aria-hidden="true">⌘</span>
        <span>Ara</span>
      </button>

      <div id="globalSearchModal" class="spotlight-modal" style="display:none;" aria-hidden="true">
        <div class="spotlight-panel" role="dialog" aria-modal="true" aria-labelledby="globalSearchTitle">
          <div class="spotlight-head">
            <div class="spotlight-head-title" id="globalSearchTitle">Site İçi Arama <span class="spotlight-shortcut">Ctrl/Cmd + K</span></div>
            <button id="globalSearchClose" class="spotlight-close" type="button" aria-label="Kapat">&times;</button>
          </div>
          <div class="spotlight-input-wrap">
            <span class="spotlight-input-icon">🔎</span>
            <input id="globalSearchInput" class="spotlight-input" type="text" placeholder="MMS, Çalışma İzni, Not, Kayıp Eşya, Dahili Numara..." autocomplete="off" />
          </div>
          <div id="globalSearchHint" class="spotlight-hint">En az 2 karakter yazın</div>
          <div id="globalSearchResults" class="spotlight-results"></div>
        </div>
      </div>

      <div id="feedbackModal" class="feedback-modal" aria-hidden="true">
        <div class="feedback-dialog" role="dialog" aria-modal="true" aria-labelledby="feedbackTitle">
          <div class="feedback-head">
            <h3 id="feedbackTitle">Geri Bildirim Gönder</h3>
            <button id="feedbackCloseBtn" class="feedback-close" type="button" aria-label="Kapat">&times;</button>
          </div>
          <textarea id="feedbackModalText" class="feedback-input" placeholder="Geri bildiriminizi yazın..."></textarea>
          <div id="feedbackModalMsg" class="feedback-msg"></div>
          <div class="feedback-actions">
            <button id="feedbackCancelBtn" class="feedback-btn" type="button">Vazgeç</button>
            <button id="feedbackSendBtn" class="feedback-btn primary" type="button">Gönder</button>
          </div>
        </div>
      </div>
    </>
  )}
  <script>
    import { finalizeShell } from '../scripts/app-shell';
    import { initLocalization } from '../scripts/localization';

    finalizeShell({ enablePwa: true, responsiveTables: true });
    initLocalization();
  </script>
  {user && (
    <script>
      import { initShellChrome } from '../scripts/shell-chrome';
      initShellChrome({ seedLocalSearch: true });
    </script>
  )}

</body>
</html>
