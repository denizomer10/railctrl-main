---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
const { title } = Astro.props;
const user = Astro.locals.user;
const assetVersion = import.meta.env.PUBLIC_ASSET_VERSION || __RAILCTRL_BUILD_ID__;
---

<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} - TCDD Yönetim Sistemi</title>
  
  <!-- Favicon -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="apple-touch-icon-precomposed" href="/apple-touch-icon-precomposed.png" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <meta name="msapplication-TileImage" content="/icons/icon-192.png" />
  <meta name="msapplication-TileColor" content="#1b2845" />
  
  <!-- PWA Meta Tags -->
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#1b2845" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="TCDD Yönetim Sistemi" />
  <meta name="description" content="TCDD Taşımacılık Yönetim Sistemi" />
  <script is:inline src={`/js/app-shell.js?v=${assetVersion}`}></script>
  <script is:inline define:vars={{ assetVersion }}>
    window.RailctrlShell?.init({ assetVersion });
  </script>
  <link rel="stylesheet" href={`/css/app.css?v=${assetVersion}`} />
  <style>
    :root {
      --primary-color: #007acc;
      --secondary-color: #005a99;
      /* make overlay transparent so background image shows */
      --background-overlay: rgba(255, 255, 255, 0.08);
      /* slightly transparent card so background peeks through */
      --card-bg: rgba(255, 255, 255, 0.52);
      --text-color: #333;
      --transition-speed: 0.3s;
      --header-bg: rgba(14, 62, 115, 0.42);
      --shadow-color: rgba(0,0,0,0.1);
      --border-color: rgba(255,255,255,0.34);
    }

    /* Dark mode variables */
    [data-theme="dark"] {
      --primary-color: #4da6ff;
      --secondary-color: #3385dd;
      /* lighter dark overlay so background remains visible */
      --background-overlay: rgba(0, 0, 0, 0.18);
      --card-bg: rgba(15, 23, 42, 0.52);
      --text-color: #ffffff;
      --header-bg: rgba(15, 23, 42, 0.54);
      --shadow-color: rgba(0,0,0,0.6);
      --border-color: rgba(148,163,184,0.2);
    }

    /* Make page background dark with overlay in dark mode */
    :global(html[data-theme="dark"] body.home-layout) {
      background: rgba(0, 0, 0, 0.8), url('/files/Marmaray.webp') no-repeat center center fixed !important;
      background-size: cover !important;
      color: var(--text-color);
    }

    * {
      box-sizing: border-box;
    }

    :global(body.home-layout) {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      margin: 0;
      padding: 0;
      background-color: var(--background-overlay) !important;
      background-image: url('/files/Marmaray.webp') !important;
      background-repeat: no-repeat !important;
      background-position: center center !important;
      background-attachment: fixed !important;
      background-size: cover !important;
      color: var(--text-color);
      min-height: 100vh;
      overflow-x: hidden;
      animation: fadeIn 0.5s ease-in;
      will-change: opacity;
    }

    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    header {
      background: var(--header-bg);
      backdrop-filter: blur(16px) saturate(150%);
      -webkit-backdrop-filter: blur(16px) saturate(150%);
      color: white;
      padding: 1rem 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      box-shadow: 0 2px 10px var(--shadow-color);
      position: sticky;
      top: 0;
      z-index: 100;
      transition: all var(--transition-speed);
    }

    .header-left {
      display: flex;
      align-items: center;
      will-change: transform, opacity;
    }

    .logo {
      height: 60px;
      margin-right: 1rem;
      transition: transform var(--transition-speed);
    }

    .logo:hover {
      transform: scale(1.05);
    }

    .header-feedback-btn {
      width: 38px;
      height: 38px;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.32);
      background: rgba(255, 255, 255, 0.14);
      color: #fff;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      margin-left: 0.35rem;
      transition: transform 0.2s ease, background 0.2s ease;
    }

    .header-feedback-btn:hover {
      transform: translateY(-1px);
      background: rgba(255, 255, 255, 0.24);
    }

    /* Mobile Styles */
    @media (max-width: 768px) {
      header {
        flex-direction: row;
        padding: 1rem;
        align-items: center;
        position: relative;
      }

      .header-left {
        margin-bottom: 0;
        flex: 1;
        display: flex;
        justify-content: center;
        order: 2; /* Mobile: logo in middle */
      }

      #nav {
        display: none;
      }

      .logo {
        height: 50px;
      }

      nav {
        display: flex;
        flex-direction: column;
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: var(--header-bg);
        backdrop-filter: blur(10px);
        padding: 1rem;
        box-shadow: 0 4px 10px var(--shadow-color);
        z-index: 99;
      }

      .sidebar {
        position: fixed;
        top: 0;
        left: -250px;
        width: 250px;
        height: 100vh;
        background: var(--header-bg);
        backdrop-filter: blur(10px);
        transition: left 0.3s ease;
        z-index: 200;
        padding: 1rem;
        box-shadow: 2px 0 10px var(--shadow-color);
      }

      .sidebar.open {
        left: 0;
      }

      .close-btn {
        background: none;
        border: none;
        color: white;
        font-size: 1.5rem;
        cursor: pointer;
        float: right;
      }

      .sidebar-nav {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-top: 2rem;
      }

      .sidebar-nav a {
        color: white;
        text-decoration: none;
        padding: 0.5rem;
        border-radius: 5px;
        background: rgba(255, 255, 255, 0.1);
        transition: background 0.3s;
      }

      .sidebar-nav a:hover {
        background: var(--border-color);
      }

      /* Disable animations on mobile for better performance */
      body, header, nav, main, .header-left {
        animation: none !important;
      }

      /* Disable hover effects on mobile */
      nav a:hover, .social-links a:hover, .logo:hover {
        transform: none !important;
        background: rgba(255, 255, 255, 0.1) !important;
        box-shadow: none !important;
      }
    }

    /* Tablet Styles */
    @media (min-width: 769px) and (max-width: 1024px) {
      nav a {
        padding: 0.5rem 0.8rem;
        font-size: 0.85rem;
      }
    }

    /* Home page centered card */
    .home-wrapper {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: calc(100vh - 72px); /* account for header height */
      padding: 2rem;
    }

    .home-card {
      width: 100%;
      max-width: 700px;
      background: var(--card-bg);
      padding: 1.5rem;
      border-radius: 10px;
      box-shadow: 0 2px 8px var(--shadow-color);
      text-align: center;
    }

    .home-card h2 {
      font-size: 4rem;
      margin: 0 0 0.5rem 0;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: var(--app-text, #111827);
      line-height: 1.02;
    }

    .home-card .subtitle {
      font-size: 1.05rem;
      margin: 0.5rem 0 0 0;
      color: var(--app-text-muted, rgba(0,0,0,0.85));
      opacity: 0.95;
    }

    .notify-bell {
      position: fixed;
      right: 1rem;
      bottom: 1rem;
      z-index: 2300;
      min-width: 46px;
      min-height: 46px;
      border-radius: 999px;
      border: 1px solid rgba(148, 163, 184, 0.35);
      background: rgba(255, 255, 255, 0.58);
      color: #0f172a;
      -webkit-backdrop-filter: blur(14px) saturate(155%);
      backdrop-filter: blur(14px) saturate(155%);
      font-size: 1.1rem;
      cursor: pointer;
      box-shadow: 0 14px 28px rgba(15, 23, 42, 0.2);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .notify-bell.bump {
      animation: notifyBellBump 0.5s ease;
    }

    @keyframes notifyBellBump {
      0% { transform: scale(1) rotate(0deg); }
      30% { transform: scale(1.14) rotate(-12deg); }
      60% { transform: scale(1.06) rotate(10deg); }
      100% { transform: scale(1) rotate(0deg); }
    }

    .notify-badge {
      position: absolute;
      top: -6px;
      right: -6px;
      background: linear-gradient(135deg, #ef4444, #dc2626);
      color: #fff;
      border: 1px solid rgba(255, 255, 255, 0.72);
      border-radius: 999px;
      padding: 3px 6px;
      line-height: 1;
      font-size: 0.72rem;
      min-width: 20px;
    }

    .notify-badge.pulse {
      animation: notifyBadgePulse 0.5s ease;
    }

    @keyframes notifyBadgePulse {
      0% { transform: scale(1); }
      40% { transform: scale(1.35); }
      100% { transform: scale(1); }
    }

    .notify-panel {
      position: fixed;
      right: 1rem;
      bottom: 4.4rem;
      width: min(380px, calc(100vw - 2rem));
      max-height: 60vh;
      background: rgba(255, 255, 255, 0.62);
      border: 1px solid rgba(148, 163, 184, 0.34);
      border-radius: 16px;
      box-shadow: 0 24px 56px rgba(2, 6, 23, 0.22);
      -webkit-backdrop-filter: blur(16px) saturate(155%);
      backdrop-filter: blur(16px) saturate(155%);
      z-index: 2400;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .notify-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 0.5rem;
      padding: 0.65rem 0.8rem;
      border-bottom: 1px solid #e5e7eb;
      font-size: 0.85rem;
    }

    .notify-head button {
      border: none;
      background: transparent;
      color: #2563eb;
      font-weight: 700;
      cursor: pointer;
    }

    .notify-list {
      overflow: auto;
      padding: 0.55rem;
      display: grid;
      gap: 0.45rem;
    }

    .notify-item {
      border: 1px solid #e5e7eb;
      border-radius: 10px;
      padding: 0.55rem 0.65rem;
      background: #f8fafc;
      font-size: 0.82rem;
    }

    .notify-item.unread {
      border-color: #93c5fd;
      background: #eff6ff;
    }

    .notify-toast {
      position: fixed;
      right: 1rem;
      bottom: 4.7rem;
      width: min(360px, calc(100vw - 2rem));
      z-index: 2450;
      background: rgba(15, 23, 42, 0.92);
      color: #f8fafc;
      border: 1px solid rgba(96, 165, 250, 0.4);
      border-radius: 12px;
      padding: 0.75rem 0.85rem;
      box-shadow: 0 20px 40px rgba(2, 6, 23, 0.45);
      opacity: 0;
      transform: translateY(12px) scale(0.98);
      pointer-events: none;
      transition: opacity 0.22s ease, transform 0.22s ease;
    }

    .notify-toast.show {
      opacity: 1;
      transform: translateY(0) scale(1);
    }

    .notify-toast-title {
      font-size: 0.84rem;
      font-weight: 700;
      margin-bottom: 0.2rem;
    }

    .notify-toast-message {
      font-size: 0.79rem;
      opacity: 0.9;
      line-height: 1.35;
      margin-bottom: 0.3rem;
    }

    .notify-toast-meta {
      font-size: 0.72rem;
      opacity: 0.74;
    }

    .feedback-modal {
      position: fixed;
      inset: 0;
      z-index: 12050;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 1rem;
      background: rgba(2, 6, 23, 0.5);
      backdrop-filter: blur(4px);
    }
    .spotlight-modal[aria-hidden="true"],
    .feedback-modal[aria-hidden="true"] {
      display: none !important;
    }
    .spotlight-modal[aria-hidden="false"],
    .feedback-modal[aria-hidden="false"] {
      display: flex !important;
    }

    .feedback-dialog {
      width: min(460px, 100%);
      background: #fff;
      border: 1px solid #dbeafe;
      border-radius: 14px;
      box-shadow: 0 24px 56px rgba(2, 6, 23, 0.3);
      padding: 0.95rem;
      display: grid;
      gap: 0.75rem;
    }

    .feedback-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.6rem;
    }

    .feedback-head h3 {
      margin: 0;
      font-size: 1rem;
      color: #0f172a;
    }

    .feedback-close {
      width: 32px;
      height: 32px;
      border: 1px solid #d1d5db;
      border-radius: 8px;
      background: #f8fafc;
      cursor: pointer;
      font-size: 1.15rem;
      line-height: 1;
    }

    .feedback-input {
      width: 100%;
      min-height: 120px;
      resize: vertical;
      border-radius: 10px;
      border: 1px solid #cbd5e1;
      padding: 0.75rem;
      font-size: 0.9rem;
      font-family: inherit;
    }

    .feedback-input:focus {
      outline: none;
      border-color: #60a5fa;
      box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.18);
    }

    .feedback-actions {
      display: flex;
      justify-content: flex-end;
      gap: 0.55rem;
    }

    .feedback-btn {
      border: 1px solid #cbd5e1;
      border-radius: 10px;
      padding: 0.52rem 0.85rem;
      background: #fff;
      color: #0f172a;
      font-weight: 600;
      cursor: pointer;
    }

    .feedback-btn.primary {
      border-color: #2563eb;
      background: #2563eb;
      color: #fff;
    }

    .feedback-msg {
      font-size: 0.84rem;
      min-height: 1.2rem;
      color: #dc2626;
    }

    .feedback-msg.success {
      color: #059669;
    }

    [data-theme="dark"] .feedback-dialog {
      background: #0f172a;
      border-color: #334155;
    }

    [data-theme="dark"] .feedback-head h3 {
      color: #e2e8f0;
    }

    [data-theme="dark"] .feedback-close {
      background: #1f2937;
      color: #e2e8f0;
      border-color: #374151;
    }

    [data-theme="dark"] .feedback-input {
      background: #111827;
      color: #e2e8f0;
      border-color: #374151;
    }

    [data-theme="dark"] .feedback-btn {
      background: #111827;
      color: #e2e8f0;
      border-color: #334155;
    }

    [data-theme="dark"] .notify-panel {
      background: rgba(15, 23, 42, 0.62);
      border-color: rgba(148, 163, 184, 0.28);
      color: #e5e7eb;
    }

    [data-theme="dark"] .notify-item {
      background: rgba(15, 23, 42, 0.54);
      border-color: rgba(148, 163, 184, 0.22);
    }

    [data-theme="dark"] .notify-bell {
      background: rgba(15, 23, 42, 0.6);
      border-color: rgba(148, 163, 184, 0.28);
      color: #eaf3ff;
      box-shadow: 0 16px 32px rgba(2, 6, 23, 0.46);
    }

    .spotlight-input-wrap { position: relative; }
    .spotlight-input { padding-right: 3rem; }
    .spotlight-voice-btn {
      position: absolute;
      right: 1.45rem;
      top: 1.2rem;
      width: 34px;
      height: 34px;
      border-radius: 10px;
      border: 1px solid #cbd5e1;
      background: #ffffff;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 0.95rem;
    }
    .spotlight-voice-btn.listening {
      border-color: #ef4444;
      color: #ef4444;
      box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.2);
    }
    .spotlight-voice-help {
      padding: 0 1rem 0.55rem;
      color: #64748b;
      font-size: 0.78rem;
      line-height: 1.35;
    }
    [data-theme="dark"] .spotlight-voice-btn {
      background: #111827;
      border-color: #374151;
      color: #e5e7eb;
    }
    [data-theme="dark"] .spotlight-voice-help {
      color: #94a3b8;
    }

    @media (max-width: 768px) {
      .home-card h2 {
        font-size: 2.4rem;
      }
    }

    @media (max-width: 768px) {
      .home-card h2 {
        font-size: 2rem;
      }
    }

    /* Respect user's motion preferences */
    @media (prefers-reduced-motion: reduce) {
      * {
        animation: none !important;
        transition: none !important;
      }
    }
  </style>
</head>
<body class="home-layout">
  <header>
    <div class="header-left">
      <a href="/">
        <img src="/logo.png" alt="TCDD Logo" class="logo" />
      </a>
      {user && (
        <button id="feedbackIconBtn" class="header-feedback-btn" type="button" aria-label="Geri bildirim">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
          </svg>
        </button>
      )}
    </div>
    {user && <Navigation />}
  </header>

  <main class="home-wrapper">
    <div class="home-card">
      <slot />
    </div>
  </main>
  <Footer />
  {user && (
    <>
      <button id="notifyBell" class="notify-bell" type="button" aria-label="Bildirimler">
        🔔
        <span id="notifyBadge" class="notify-badge" style="display:none;">0</span>
      </button>
      <div id="notifyPanel" class="notify-panel" style="display:none;">
        <div class="notify-head">
          <strong>Bildirimler</strong>
          <div style="display:flex; gap:.45rem;">
            <button id="markAllNotifications" type="button">Okundu yap</button>
            <button id="clearNotifications" type="button">Temizle</button>
          </div>
        </div>
        <div id="notifyList" class="notify-list"></div>
      </div>
      <div id="notifyToast" class="notify-toast" aria-live="polite"></div>

      <button id="globalSearchFab" class="spotlight-fab" type="button" aria-label="Site içinde ara">
        <span class="spotlight-fab-icon" aria-hidden="true">⌘</span>
        <span>Ara</span>
      </button>

      <div id="globalSearchModal" class="spotlight-modal" style="display:none;" aria-hidden="true">
        <div class="spotlight-panel" role="dialog" aria-modal="true" aria-labelledby="globalSearchTitle">
          <div class="spotlight-head">
            <div class="spotlight-head-title" id="globalSearchTitle">Site İçi Arama <span class="spotlight-shortcut">Ctrl/Cmd + K</span></div>
            <button id="globalSearchClose" class="spotlight-close" type="button" aria-label="Kapat">&times;</button>
          </div>
          <div class="spotlight-input-wrap">
            <span class="spotlight-input-icon">🔎</span>
            <input id="globalSearchInput" class="spotlight-input" type="text" placeholder="MMS, Çalışma İzni, Not, Kayıp Eşya, Dahili Numara..." autocomplete="off" />
            <button id="globalSearchVoiceBtn" class="spotlight-voice-btn" type="button" aria-label="Sesli arama">🎙️</button>
          </div>
          <div id="globalSearchHint" class="spotlight-hint">En az 2 karakter yazın</div>
          <div class="spotlight-voice-help">MMS için: <b>arıza kaydı oluştur</b> • Çalışma izni için: <b>çalışma izni ekle</b> • İstasyon için: <b>gebze istasyon şeması</b></div>
          <div id="globalSearchResults" class="spotlight-results"></div>
        </div>
      </div>

      <div id="feedbackModal" class="feedback-modal" aria-hidden="true">
        <div class="feedback-dialog" role="dialog" aria-modal="true" aria-labelledby="feedbackTitle">
          <div class="feedback-head">
            <h3 id="feedbackTitle">Geri Bildirim Gönder</h3>
            <button id="feedbackCloseBtn" class="feedback-close" type="button" aria-label="Kapat">&times;</button>
          </div>
          <textarea id="feedbackModalText" class="feedback-input" placeholder="Geri bildiriminizi yazın..."></textarea>
          <div id="feedbackModalMsg" class="feedback-msg"></div>
          <div class="feedback-actions">
            <button id="feedbackCancelBtn" class="feedback-btn" type="button">Vazgeç</button>
            <button id="feedbackSendBtn" class="feedback-btn primary" type="button">Gönder</button>
          </div>
        </div>
      </div>
    </>
  )}
  
  <script>
    window.RailctrlShell?.finalize({ enablePwa: true });
  </script>
  {user && (
    <script is:inline>
      (() => {
        const notifyBell = document.getElementById('notifyBell');
        const notifyBadge = document.getElementById('notifyBadge');
        const notifyPanel = document.getElementById('notifyPanel');
        const notifyList = document.getElementById('notifyList');
        const markAllBtn = document.getElementById('markAllNotifications');
        const clearBtn = document.getElementById('clearNotifications');
        const notifyToast = document.getElementById('notifyToast');
        const feedbackIconBtn = document.getElementById('feedbackIconBtn');
        const feedbackModal = document.getElementById('feedbackModal');
        const feedbackCloseBtn = document.getElementById('feedbackCloseBtn');
        const feedbackCancelBtn = document.getElementById('feedbackCancelBtn');
        const feedbackSendBtn = document.getElementById('feedbackSendBtn');
        const feedbackModalText = document.getElementById('feedbackModalText');
        const feedbackModalMsg = document.getElementById('feedbackModalMsg');
        const fab = document.getElementById('globalSearchFab');
        const modal = document.getElementById('globalSearchModal');
        const closeBtn = document.getElementById('globalSearchClose');
        const input = document.getElementById('globalSearchInput');
        const voiceBtn = document.getElementById('globalSearchVoiceBtn');
        const hint = document.getElementById('globalSearchHint');
        const resultsEl = document.getElementById('globalSearchResults');
        let toastTimer;
        let initialized = false;
        let prevUnread = 0;
        let latestNotificationId = null;

        const staticPages = [
          { title: 'Haritalar', subtitle: 'Marmaray ve İstanbul ulaşım haritaları', href: '/guzergah', type: 'Sayfa', keywords: 'guzergah marmaray harita istanbul ulasim metro metrobus' },
          { title: 'Vardiya', subtitle: 'Aylık vardiya planlama ekranı', href: '/vardiya', type: 'Sayfa', keywords: 'vardiya planlama istasyon ay hafta' },
