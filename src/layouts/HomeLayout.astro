        const waitVoiceYesThenNavigate = (targetHref, promptText = '') => {
          if (!SpeechRecognitionCtor) return;
          let resolved = false;
          let retryCount = 0;
          const maxRetries = 2;
          const isYes = (text) => /\b(evet|tamam|onay|onayla|ac|aç)\b/.test(text);
          const isNo = (text) => /\b(hayır|hayir|iptal|vazgeç|vazgec)\b/.test(text);
          const startConfirm = () => {
            const confirmRec = new SpeechRecognitionCtor();
            confirmRec.lang = 'tr-TR';
            confirmRec.continuous = false;
            confirmRec.interimResults = false;
            confirmRec.maxAlternatives = 1;
            voiceConfirmListening = true;
            hint.textContent = 'Onay bekleniyor... "evet" derseniz açılacak.';
            confirmRec.onresult = (e) => {
              const said = String(e.results?.[0]?.[0]?.transcript || '').toLocaleLowerCase('tr-TR').trim();
              if (isYes(said)) {
                resolved = true;
                if (targetHref) window.location.href = targetHref;
                return;
              }
              if (isNo(said)) {
                resolved = true;
                hint.textContent = 'İptal edildi. Başka bir komut söyleyin ya da arayın.';
                return;
              }
              hint.textContent = 'Anlaşılmadı. Başka bir komut söyleyin ya da arayın.';
            };
            confirmRec.onend = () => {
              voiceConfirmListening = false;
              if (!resolved && retryCount < maxRetries) {
                retryCount += 1;
                hint.textContent = 'Onay algılanmadı. Lütfen "evet" veya "hayır" deyin.';
                setTimeout(startConfirm, 180);
              }
            };
            confirmRec.onerror = () => {
              voiceConfirmListening = false;
              hint.textContent = 'Sesli onay alınamadı. Başka bir komut söyleyin ya da arayın.';
            };
            confirmRec.start();
          };

          // Onay dinlemeyi TTS bitişine bağlamıyoruz; bazı tarayıcılarda algılama kaçabiliyor.
          setTimeout(startConfirm, 120);
          if (promptText) {
            speak(promptText);
